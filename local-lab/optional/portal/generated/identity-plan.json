{
  "kind": "PortalIdentityPlan",
  "mode": "review-only",
  "realm": "perkforge",
  "currentProviderChangeRequired": "Paused HTTP Keycloak must receive separately approved trusted HTTPS configuration",
  "secretDelivery": {
    "namespace": "tenant-home-portal",
    "name": "portal-oidc",
    "key": "client-secret",
    "action": "operator-managed; never generated by this renderer"
  },
  "requiredExistingGroups": [
    "/tenants/home/admins",
    "/tenants/home/developers",
    "/tenants/home/viewers"
  ],
  "automaticRoleAssignments": [],
  "clients": [
    {
      "clientId": "household-portal",
      "protocol": "openid-connect",
      "enabled": false,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "https://portal.local-lab.test/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "perkforge-managed": "true",
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "300"
      },
      "protocolMappers": [
        {
          "name": "portal-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "household-portal-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "portal-client-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "household-portal-api",
            "claim.name": "resource_access.household-portal-api.roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "household-portal-api",
      "protocol": "openid-connect",
      "enabled": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "apiClientRoles": [
    {
      "client": "household-portal-api",
      "role": "tenant-reader"
    }
  ],
  "requiredClientScopeMapping": {
    "client": "household-portal",
    "targetClient": "household-portal-api",
    "roles": [
      "tenant-reader"
    ]
  },
  "grantPolicy": "Platform must separately approve role membership; Home group membership alone is insufficient. No grants are generated."
}
