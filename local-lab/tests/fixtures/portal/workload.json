[
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "home-portal",
      "namespace": "tenant-home-portal"
    },
    "spec": {
      "type": "ClusterIP",
      "selector": {
        "app.kubernetes.io/name": "perkforge-portal"
      },
      "ports": [
        {
          "name": "http",
          "port": 3000,
          "targetPort": "http"
        }
      ]
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "home-portal",
      "namespace": "tenant-home-portal",
      "labels": {
        "app.kubernetes.io/name": "perkforge-portal"
      }
    },
    "spec": {
      "replicas": 1,
      "strategy": {
        "type": "Recreate"
      },
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/name": "perkforge-portal"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/name": "perkforge-portal"
          }
        },
        "spec": {
          "serviceAccountName": "portal-runtime",
          "automountServiceAccountToken": false,
          "imagePullSecrets": [
            {
              "name": "portal-ghcr"
            }
          ],
          "securityContext": {
            "runAsNonRoot": true,
            "runAsUser": 1000,
            "runAsGroup": 1000,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "containers": [
            {
              "name": "portal",
              "image": "ghcr.io/perkforge/perkforge-portal@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "imagePullPolicy": "IfNotPresent",
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "readOnlyRootFilesystem": true,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              },
              "ports": [
                {
                  "name": "http",
                  "containerPort": 3000
                }
              ],
              "env": [
                {
                  "name": "LISTEN_HOST",
                  "value": "0.0.0.0"
                },
                {
                  "name": "PORTAL_ORIGIN",
                  "value": "https://portal.local-lab.test"
                },
                {
                  "name": "TENANT_SOURCE",
                  "value": "disabled"
                },
                {
                  "name": "OIDC_ISSUER",
                  "value": "https://keycloak.local-lab.test/auth/realms/perkforge"
                },
                {
                  "name": "OIDC_CLIENT_ID",
                  "value": "household-portal"
                },
                {
                  "name": "OIDC_AUDIENCE",
                  "value": "household-portal-api"
                },
                {
                  "name": "OIDC_CLIENT_SECRET",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "portal-oidc",
                      "key": "client-secret"
                    }
                  }
                }
              ],
              "resources": {
                "requests": {
                  "cpu": "25m",
                  "memory": "64Mi"
                },
                "limits": {
                  "cpu": "250m",
                  "memory": "192Mi"
                }
              },
              "readinessProbe": {
                "httpGet": {
                  "path": "/healthz",
                  "port": "http"
                },
                "periodSeconds": 10
              },
              "livenessProbe": {
                "httpGet": {
                  "path": "/healthz",
                  "port": "http"
                },
                "initialDelaySeconds": 10,
                "periodSeconds": 20
              }
            }
          ]
        }
      }
    }
  }
]
