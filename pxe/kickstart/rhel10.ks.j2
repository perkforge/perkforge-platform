# DESIGN CANDIDATE ONLY — NOT DEPLOYABLE, NOT SERVED, NO INSTALL APPROVAL.
# Always aborts in %pre. Draft storage/bootstrap adapters, when supplied, remain
# unreachable behind that abort. No credential hash/private key. Do not wire into GRUB.
# Required inputs are supplied only by synthetic offline tests for now.
# Vendor baseline: infrastructure/RHEL-PROVISIONING-GUIDANCE.md (RHEL10/10.2).
# Standard directives are candidates, not a ksvalidator/rehearsal pass.

text --non-interactive
lang en_US.UTF-8
keyboard us
url --url="{{ installation_source_url }}"
timezone {{ timezone }} --utc
timesource --ntp-server {{ ntp_server }}
network --bootproto=dhcp --device={{ boot_nic_mac }} --activate --hostname={{ hostname }}
rootpw --lock
user --name={{ bootstrap_username }} --shell=/bin/bash --lock
sshkey --username={{ bootstrap_username }} "{{ bootstrap_public_key }}"
selinux --enforcing
firewall --enabled --service=ssh
services --disabled=sshd

%pre --erroronfail --log=/tmp/perkforge-candidate-pre.log
printf '%s\n' 'BLOCKED: non-deployable design candidate; disk identity and credential implementation unvalidated.' >&2
exit 1
%end

# STORAGE POLICY DRAFT ONLY; never uncomment without real RHEL validation,
# verified persistent disk targeting and a newly approved exact node/disk plan.
# Required disk stable ID: {{ disk_stable_id }}
# Required serial: {{ disk_serial }}
# Required capacity bytes: {{ disk_capacity_bytes }}
# intended: ignoredisk restricted to the verified disk
# intended: clearpart restricted to that same disk, never unrestricted all disks
# intended: EFI600MiB + XFS /boot2GiB + ordinary LVM/XFS root using remainder
# no separate home/swap; encryption/FIPS must be explicit per-target decisions

%packages
@^minimal-environment
openssh-server
sudo
python3
kernel-modules-extra
%end

