#version=RHEL9

graphical
url --url="{{ rhel_install_tree_url }}"
network --bootproto=dhcp --device=link --activate --hostname={{ inventory_hostname }}
lang en_US.UTF-8
keyboard us
timezone Etc/UTC --utc
rootpw --lock

# Storage is intentionally left to the installer UI until the target disks and
# desired layout are known. Add explicit reviewed storage commands here later.

# Deliberately no user/password/key or unattended license acceptance. Create the
# reviewed administrator at the console; root stays locked. Do not serve secrets.
# Halt so a completed install cannot automatically enter PXE again.
halt

%packages
@^minimal-environment
%end
