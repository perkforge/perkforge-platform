# DISPOSABLE ISOLATED VM ONLY; separate from always-blocked physical candidate.
# Caller gates synthetic identities/disks, exact namespaces, credentials and EULA.
text --non-interactive
lang en_US.UTF-8
keyboard us
url --url="http://192.0.2.10:8080/rhel-10.2/"
timezone Etc/UTC --utc
# This isolated test has no external NTP route; physical time config is separate.
timesource --ntp-disable
network --bootproto=dhcp --device=02:00:00:00:00:11 --activate --hostname=rehearsal.invalid
rootpw --lock
user --name=bootstrap --shell=/bin/bash --lock
sshkey --username=bootstrap "{{ bootstrap_public_key }}"
selinux --enforcing
firewall --enabled --service=ssh
services --disabled=sshd
firstboot --disable
eula --agreed
reboot --eject
{{ bootstrap_storage_fragment }}
%packages
@^minimal-environment
openssh-server
sudo
python3
kernel-modules-extra
%end
{{ bootstrap_initial_post_fragment }}
