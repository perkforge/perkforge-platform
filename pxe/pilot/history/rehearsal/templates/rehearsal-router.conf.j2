# Simulated address-only LAN router, wholly inside guest namespace.
port=0
interface=bridge0
bind-interfaces
no-hosts
no-resolv
user=dnsmasq
group=nogroup
pid-file={{ rehearsal_root }}/state/router/dnsmasq.pid
log-facility={{ rehearsal_root }}/logs/router/dnsmasq.log
dhcp-leasefile={{ rehearsal_root }}/state/router/leases
dhcp-range=192.0.2.11,192.0.2.11,255.255.255.0,1h
dhcp-host=02:00:00:00:00:11,set:fixture,192.0.2.11
dhcp-ignore=tag:!fixture
# No default gateway or DNS: guest has no LAN/Internet route.
dhcp-option=option:router
dhcp-option=option:dns-server
