# ISOLATED DISPOSABLE VM ONLY. Never serve this menu to a physical target.
set default=0
set timeout=3
menuentry 'Disposable installer rehearsal only' {
    {{ rehearsal_linux_command }} /images/pxeboot/vmlinuz ip=dhcp console=ttyS0,115200n8 inst.text inst.noninteractive inst.repo=http://192.0.2.10:8080/rhel-10.2/ inst.ks=http://192.0.2.10:8080/rhel-10.2/perkforge-rehearsal/install.ks
    {{ rehearsal_initrd_command }} /images/pxeboot/initrd.img
}
