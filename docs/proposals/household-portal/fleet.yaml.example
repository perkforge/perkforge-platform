# INACTIVE review material. Do not apply or add to active Fleet paths.
apiVersion: management.cattle.io/v3
kind: FleetWorkspace
metadata:
  name: fleet-home-portal
---
apiVersion: fleet.cattle.io/v1alpha1
kind: Policy
metadata:
  name: portal-only
  namespace: fleet-home-portal
requireServiceAccount: true
allowNamespaceCreation: false
allowedServiceAccounts: [home-portal-deployer]
gitRepo:
  allowedRepoPatterns:
  - ^https://github[.]com/perkforge/perkforge-tenant-portal[.]git$
---
apiVersion: fleet.cattle.io/v1alpha1
kind: BundleNamespaceMapping
metadata:
  name: portal-to-local
  namespace: fleet-home-portal
bundleSelector:
  matchLabels:
    platform.perkforge.io/tenant: home
    platform.perkforge.io/application: portal
namespaceSelector:
  matchLabels:
    kubernetes.io/metadata.name: fleet-local
---
apiVersion: fleet.cattle.io/v1alpha1
kind: GitRepo
metadata:
  name: tenant-home-portal
  namespace: fleet-home-portal
  labels:
    platform.perkforge.io/tenant: home
    platform.perkforge.io/application: portal
spec:
  repo: https://github.com/perkforge/perkforge-tenant-portal.git
  revision: REPLACE_WITH_REVIEWED_TENANT_COMMIT
  paused: true
  targetNamespace: tenant-home-portal
  serviceAccount: home-portal-deployer
  keepResources: true
  paths: [bundles/portal]
  targets:
  - name: local
    clusterName: local
