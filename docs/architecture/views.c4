views {
  view index {
    title 'Physical provisioning — system context'
    description 'Start here, then click workstation, node or platform to narrow the architecture. Use operations for the repeatable process; protocol, installation, access and lifecycle views provide detail. Select topology for the workstation/three-node relationships. These views are documentation, not live status or approval.'
    link /runbook.html 'Operating runbook'
    include engineer, router, workstation, node, approval, custody, platform
  }
  view topology of local_network {
    title 'Topology — workstation and three physical nodes'
    description 'Workstation and three nodes share the existing wired LAN. Arrows show SSH traffic, not point-to-point wiring. Actual IP/MAC values remain in the ignored inventory/.topology.yml, excluded from the public viewer.'
    link /runbook.html#topology 'Inventory and network roles'
    include controller, control_1, worker_1, worker_2
  }
  view workstation_detail of workstation {
    title 'Workstation — PXE services, ownership and evidence'
    description 'Ansible manages reviewed private configuration and dedicated serving resources; the router and existing system/libvirt services remain separate. Boot media is public/nonsecret; transaction records and credentials are protected.'
    include workspace, review, lifecycle, guard, proxy, tftp, http, ssh, evidence
  }
  view workspace_detail of workstation.workspace {
    title 'Private node workspace — inputs, discovery and access artifacts'
    description 'Narrow from workstation to the ignored per-node directory. Metadata/review files are not live service configuration or secret custody; runtime/log roots and staged media stay outside this tree. See construction flow and linked directory recipe.'
    link /runbook.html#workspace 'Directory layout and creation recipe'
    include target_inputs, discovery, access
  }
  dynamic view workspace_construction {
    title 'Construct a worker workspace — provenance through retained evidence'
    description 'Tracked offline Ansible rebuild from a backed-up input file; generated working artifacts are reproducible, unique evidence and credentials require restore or new verification. Keep private target values in ignored files, use fresh output/run names and review each launcher against the exact retained state. No credentials or session timelines in this model.'
    link /runbook.html#workspace 'Repeatable workspace construction'
    engineer -> workstation.workspace.target_inputs '1. Supply backed-up confirmed metadata and a fresh node/run label'
    engineer -> workstation.workspace.target_inputs '2. Validate names, metadata, destination absence and safe ancestor ownership'
    workstation.workspace.target_inputs -> workstation.review '3. workspace.yml invokes shared prepare.yml for a fresh private render'
    workstation.review -> workstation.workspace.discovery '4. Assemble protected run, retained renders, input snapshot and exact hash manifest'
    engineer -> workstation.workspace.discovery '5. Generate standard session caller; human reviews content and approves action separately'
    workstation.workspace.discovery -> workstation.lifecycle '6. Separate approved preserve/start verifies retained state and installs native copies'
    workstation.lifecycle -> workstation.workspace.discovery '7. Save unique private logs and bounded exit summaries; preserve prior evidence'
    workstation.ssh -> workstation.workspace.access '8. Later approved access run creates fresh host-trust and verification evidence'
  }
  view node_detail of node {
    title 'Physical node — firmware through installed OS'
    description 'Menu acceptance, disk inspection, erase approval, installation and first disk boot are separate transitions. Firmware selection and installer settings are operator steps in this interactive process.'
    include firmware, menu, installer, disk, os
  }
  dynamic view operations {
    title 'Repeat physical installation — operations 1–7'
    description 'Interactive RHEL installation using the existing PXE transport. Each stage links to required inputs, operator actions and completion checks. Review actions for each target; do not inherit a previous node approval.'
    link /runbook.html 'Repeatable runbook'
    engineer -> workstation.review '1. Prepare reviewed PXE configuration' {
      navigateTo workspace_construction
      notes '[1. Prepare](/runbook.html#prepare). Operator: select node/network/media and review configuration. Automation: Ansible renders fresh private review files only. Evidence / stop: verified media/assets and hashes; missing prerequisites or existing output stop preparation.'
    }
    engineer -> approval '2. Review target, disk and action scope' {
      notes '[2. Review](/runbook.html#approve). Operator: approve service exposure and boot; inspect disk before separate erase/access decisions. Automation: activation enforces service preflight, not disk identity. Evidence / stop: exact selected node and sufficient disk evidence; stop for ambiguity or consequential scope changes.'
    }
    engineer -> node.firmware '3. Activate PXE and select network boot' {
      navigateTo boot_protocol
      notes '[3. Boot](/runbook.html#boot). Operator: run approved activation then select wired UEFI IPv4 PXE, retaining Secure Boot; record temporary Primary Boot Sequence change if needed. Automation: dedicated services serve a client-initiated exchange. Evidence / stop: reviewed indefinite GRUB menu; menu arrival is not installer or erase approval.'
    }
    engineer -> node.installer '4. Install RHEL with reviewed settings' {
      navigateTo installation
      notes '[4. Install](/runbook.html#install). Operator: review disk/layout, Minimal Install, hostname/network and root-disabled named administrator; commit only approved storage changes. Automation: Anaconda installs from HTTP source. Evidence / stop: installation completion; retain source services and stop on unexpected disks or errors.'
    }
    engineer -> node.os '5. Restore disk-first and boot installed OS' {
      notes '[5. First boot](/runbook.html#firstboot). Operator: after installation completes, restore disk-first Primary Boot Sequence before normal boot. Automation: firmware boots the installed disk. Evidence / stop: installed OS login and expected hostname, no installer loop; retain source until no longer needed.'
    }
    workstation.ssh -> node.os '6. Verify identity, key login and sudo' {
      navigateTo security_handoff
      notes '[6. Verify](/runbook.html#verify). Operator: compare full host fingerprint through physical console and enter credentials locally. Automation: standard SSH tools enroll the public key; approved policy hardening requires syntax/effective-policy validation. Evidence / stop: fresh key-only login and password-sudo; retain recovery access on failure. Cluster readiness is separate.'
    }
    engineer -> workstation.lifecycle '7. Stop owned services and retain evidence' {
      navigateTo service_lifecycle
      notes '[7. Cleanup](/runbook.html#cleanup). Operator: authorize shutdown once source is no longer needed and read its result. Automation: verify transaction/unit/guard identity, stop only owned resources and check original services unchanged. Evidence / stop: owned processes/listeners/guard gone, logs retained; report incomplete on mismatch.'
    }
  }
  dynamic view boot_protocol {
    variant sequence
    title 'Boot protocol — router DHCP, proxy PXE, TFTP and HTTP'
    description 'Reference exchange, not a packet trace. Router allocates; proxy supplies boot information. GRUB can wait indefinitely before the separately approved installer choice. PXE does not provide a remote disk-inventory service.'
    link /runbook.html#boot 'Boot settings and checks'
    node.firmware -> router '1. Client requests DHCP lease (UDP68 → UDP67)'
    router -> node.firmware '2. Router allocates address'
    node.firmware -> workstation.proxy '3. PXE/proxy boot-information exchange'
    workstation.proxy -> node.firmware '4. Metadata only, no address allocation'
    node.firmware -> workstation.tftp '5. Request vendor shim/GRUB and config (TFTP UDP69 + reviewed transfer ports)'
    workstation.tftp -> node.menu '6. Indefinite default-exit menu'
    engineer -> node.menu '7. Select interactive installer within approved scope'
    node.menu -> workstation.tftp '8. Request kernel/initrd'
    node.menu -> node.installer '9. Boot installer initramfs'
    node.installer -> workstation.http '10. HTTP TCP8080: runtime and package requests'
    workstation.http -> node.installer '11. Full verified DVD tree including .treeinfo'
  }
  dynamic view installation {
    title 'Installation detail — interactive disk, layout and account review'
    description 'Manual Anaconda path. Pending partition edits are reviewed before Begin Installation commits storage changes. This process does not establish unattended Kickstart or automatic credential handoff support.'
    link /runbook.html#install 'Exact repeat settings'
    engineer -> node.installer '1. Language → Installation Summary → inspect destination'
    node.installer -> engineer '2. Review internal disk count, model, capacity and device'
    engineer -> approval '3. Approve this target disk data loss and account scope'
    engineer -> node.disk '4. Custom layout:600MiB EFI,2GiB XFS /boot, remaining XFS LVM root'
    engineer -> node.installer '5. Minimal Install; hostname/wired network; root disabled, named admin'
    engineer -> node.installer '6. Review only selected-disk changes; Begin Installation'
    node.installer -> workstation.http '7. Fetch packages; keep source available through completion'
    engineer -> node.firmware '8. After completion restore disk-first before normal boot'
    node.firmware -> node.os '9. Verify installed OS boots'
  }
  dynamic view security_handoff {
    title 'Access handoff — host trust, public key and fresh verification'
    description 'Standard tools and explicit access scope; credentials stay local. Initial installed-host SSH availability must be inspected. Any temporary password-SSH window needs separate approval, a bounded purpose and verified closure.'
    link /runbook.html#access 'Access procedure and boundaries'
    engineer -> node.os '1. Physical console: confirm hostname, address and complete host fingerprint'
    engineer -> workstation.ssh '2. Compare full fingerprint before accepting host trust'
    custody -> workstation.ssh '3. Existing private key stays protected; local password/passphrase input'
    workstation.ssh -> node.os '4. Approved public-key enrollment with standard tools'
    workstation.ssh -> node.os '5. Fresh key-only login before policy change'
    engineer -> node.os '6. Approved hardening: validate syntax/effective policy then reload'
    workstation.ssh -> node.os '7. Fresh key-only login and password-authenticated sudo'
    node.os -> platform.readiness '8. Separate host readiness and cluster approval'
  }
  dynamic view service_lifecycle {
    title 'PXE lifecycle — preflight, exposure, identity and shutdown'
    description 'Reusable ownership contract for existing Ansible components. Fresh activation refuses retained roots/units; recovery requires a new exact-state review. No broad reset, service termination or evidence deletion.'
    link /runbook.html#lifecycle 'Preflight, recovery and shutdown'
    engineer -> workstation.lifecycle '1. Approve reviewed service scope and lifetime'
    workstation.lifecycle -> workstation.review '2. Check hashes, interface, media, free ports and original services'
    workstation.lifecycle -> workstation.evidence '3. Root-controlled unique config; retain transaction record'
    workstation.lifecycle -> workstation.guard '4. Exclusive dedicated guard before LAN bindings'
    workstation.lifecycle -> workstation.proxy '5. Launch dedicated dnsmasq unit'
    workstation.lifecycle -> workstation.http '6. Launch dedicated HTTP unit'
    workstation.lifecycle -> workstation.evidence '7. Verify runtime/listeners/original services; save private result'
    engineer -> workstation.lifecycle '8. Explicit shutdown after source no longer needed'
    workstation.lifecycle -> workstation.evidence '9. Check exact config/invocation/guard ownership; preserve on mismatch'
    workstation.lifecycle -> workstation.guard '10. Stop owned units, verify listeners/processes gone, remove matching guard'
    workstation.lifecycle -> workstation.evidence '11. Retain runtime/log evidence; verify original services preserved'
  }
  view platform_detail of platform {
    title 'Platform boundary — readiness and ownership'
    description 'Separate operating scope after OS/access. Infrastructure Ansible owns host/RKE2; reviewed Ansible operations currently apply installer foundations before Helm rendering. Platform Ansible owns gated Rancher API configuration. Rancher owns platform-admin cluster lifecycle; Flux reconciles explicitly promoted releases and Big Bang supplies packages. Enrollment and application repositories retain their respective ownership.'
    link /runbook.html#platform 'Platform readiness and responsibilities'
    include readiness, rke2, storage, rancher, flux, bigbang, enrollment, applications
  }
  view rke2_detail of platform.rke2 {
    title 'RKE2 — server, workers, networking, access and recovery'
    description 'One server and two agents, without HA. Readiness is separate from workload/network, reboot and recovery validation. Application storage is a separate decision. Actual topology and all credentials stay private.'
    link /runbook.html#rke2 'Architecture and human repeat process'
    include server, agents, networking, operator_access, recovery
  }

  view storage_detail of platform.storage {
    title 'Storage — application claims, worker replicas and independent backups'
    description 'OBSERVED: installed and Ready at v0.11.3; first 1Gi persistence/recreation/cross-worker reattachment and two-replica checks passed. Retained test resources require cleanup approval. Backup/restore, node-failure recovery and HA are not proven. Rancher Helm has no PVC dependency.'
    link /runbook.html#storage 'Storage rollout and next tests'
    include volumes, replica_pair, acceptance, backups
  }

  dynamic view bootstrap_installer_flow {
    title 'Big Bang bootstrap — release, prerequisites and delegated package installation'
    description 'General bootstrap ownership with Longhorn as the current concrete package. Each package needs its own reviewed installer contract; Longhorn diagnostic cluster-admin is an accepted lab exception, not a global default. Rancher first installed at v0.12.0 remains Ready at v0.14.0 with first login pending and identity/tenants remain unselected. This is a procedure model, not live approval.'
    link /runbook.html#longhorn-rbac 'Bootstrap ownership, code and Longhorn trust example'
    engineer -> platform.prerequisite_applier '1. Review exact published release, target and shared/per-package prerequisites'
    platform.prerequisite_applier -> platform.longhorn_installer '2. Approved Ansible applies shared and selected package RBAC; Longhorn example'
    engineer -> platform.flux '3. Separately approve source selection; verify artifact before root resume'
    platform.flux -> platform.bigbang '4. Application root reconciles the Big Bang umbrella'
    platform.bigbang -> platform.longhorn_installer '5. Generates selected package HelmRelease with delegated serviceAccountName'
    platform.flux -> platform.longhorn_installer '6. helm-controller impersonates that package installer for Helm operations'
    platform.longhorn_installer -> platform.longhorn_runtime '7. Helm creates package resources/runtime identities; Longhorn diagnostic exception'
    platform.longhorn_runtime -> platform.storage '8. Verify readiness, then separately approve package acceptance tests'
  }

  dynamic view app_stage_promotion {
    title 'One release — approved app stages and acceptance'
    description 'OBSERVED OpenBao/Headlamp/Keycloak acceptance at v0.14.0; root now local-keycloak, no realm/group/SSO activation. Fixed Kustomize stage roots share one immutable artifact. Preserve Longhorn/Rancher. Stop after every app for access/custody and health/capacity acceptance; no automatic backward-stage rollback or auth integration.'
    link /runbook.html#app-stages 'Stage paths, ownership and stop gates'
    engineer -> platform.prerequisite_applier '1. Review exact release and approve only OpenBao inputs/prerequisites'
    engineer -> platform.flux '2. Promote verified source; default local path selects OpenBao only'
    platform.flux -> platform.openbao.runtime '3. Install; approved initialization/unseal custody and admin access are separate gates'
    platform.openbao.runtime -> engineer '4. Verify Ready, custody/access and per-node health/storage headroom; stop on failure'
    engineer -> platform.flux '5. Approve Headlamp prerequisites; advance same-artifact root to local-headlamp'
    platform.headlamp.runtime -> engineer '6. Verify token access and health/capacity before next approval'
    engineer -> platform.flux '7. Approve Keycloak/database inputs; advance root to local-keycloak'
    platform.keycloak.runtime -> engineer '8. Verify database, initial admin access and health; OIDC/group apply remains separate'
  }

  dynamic view storage_acceptance {
    title 'Storage acceptance — one approved retained 1Gi test'
    description 'OBSERVED PASS: initial write, same-worker recreation and worker-to-worker reattachment used one claim with identical checksums. Two healthy replicas on distinct workers. No reboot, forced detach, backup/restore or HA proof; no automatic cleanup.'
    link /runbook.html#storage 'Test outcome, limits and retained-resource handoff'
    engineer -> platform.storage.acceptance '1. Approve exact target, disposable 1Gi scope and retention'
    platform.storage.acceptance -> platform.storage.volumes '2. Ansible creates unique namespace/PVC and scheduler-placed non-root pod on worker-1'
    platform.storage.volumes -> platform.storage.acceptance '3. Write nonsecret sample, sync and record checksum/UIDs'
    platform.storage.acceptance -> platform.storage.volumes '4. Gracefully recreate pod on worker-1; verify original checksum'
    platform.storage.volumes -> platform.storage.replica_pair '5. Normal CSI detach, worker-2 reattachment and checksum verification'
    platform.storage.replica_pair -> platform.storage.acceptance '6. Read-only verifier confirms two healthy distinct-worker replicas, both RW'
    platform.storage.acceptance -> engineer '7. Retain test claim/PV/volume, final pod and evidence; cleanup needs separate approval'
  }

  view authorization_roles {
    title 'Who does what and why — six human roles and trust boundaries'
    description 'Proposed shared realm and role intent; no live grants. Zoom into core apps, observability, collaboration and tenant examples. App policies cannot promise secrecy against cluster/shared-identity administrators.'
    link /runbook.html#authorization-matrix 'Matrix, evidence classes and implementation gates'
    include platform.authorization.roles.pa, platform.authorization.roles.pe, platform.authorization.roles.pv, platform.authorization.roles.ta, platform.authorization.roles.td, platform.authorization.roles.tv, platform.authorization.groups, platform.authorization.clients, platform.authorization.ownership
  }
  view authorization_core_apps {
    title 'Role mappings — Core identity/infrastructure'
    description 'Design matrix, not deployed integrations. Select each app for PA/PE/PV/TA/TD/TV scope, edition limits and missing enforcement. Every app validates its client/token and resource ownership; machine identities are separate.'
    link /runbook.html#authorization-matrix 'Role matrix and source/test links'
    include platform.authorization.clients, platform.authorization.ownership, platform.authorization.mappings.keycloak, platform.authorization.mappings.kubernetes, platform.authorization.mappings.rancher, platform.authorization.mappings.openbao, platform.authorization.mappings.longhorn
  }
  view authorization_observability {
    title 'Role mappings — Observability query and notification boundaries'
    description 'Design matrix, not deployed integrations. Select each app for PA/PE/PV/TA/TD/TV scope, edition limits and missing enforcement. Every app validates its client/token and resource ownership; machine identities are separate.'
    link /runbook.html#authorization-matrix 'Role matrix and source/test links'
    include platform.prerequisite_applier, platform.authorization.clients, platform.authorization.ownership, platform.authorization.mappings.grafana, platform.authorization.mappings.prometheus, platform.authorization.mappings.loki, platform.authorization.mappings.alloy, platform.authorization.mappings.alerts
  }
  view authorization_collaboration {
    title 'Role mappings — Collaboration project/team permissions'
    description 'Design matrix, not deployed integrations. Select each app for PA/PE/PV/TA/TD/TV scope, edition limits and missing enforcement. Every app validates its client/token and resource ownership; machine identities are separate.'
    link /runbook.html#authorization-matrix 'Role matrix and source/test links'
    include platform.authorization.clients, platform.authorization.ownership, platform.authorization.mappings.mattermost, platform.authorization.mappings.gitlab, platform.authorization.mappings.harbor, platform.authorization.mappings.sonarqube
  }
  view authorization_tenant_apps {
    title 'Role mappings — Tenant app and control-component examples'
    description 'Design matrix, not deployed integrations. Select each app for PA/PE/PV/TA/TD/TV scope, edition limits and missing enforcement. Every app validates its client/token and resource ownership; machine identities are separate.'
    link /runbook.html#authorization-matrix 'Role matrix and source/test links'
    include platform.prerequisite_applier, platform.authorization.clients, platform.authorization.ownership, platform.authorization.mappings.portal, platform.authorization.mappings.nextcloud, platform.authorization.mappings.velero, platform.authorization.mappings.trivy, platform.authorization.mappings.traffic
  }
  dynamic view authorization_review {
    title 'Who does what and why — proposed human authorization'
    description 'Disabled configuration, not observed grants. Installer/runtime accounts stay distinct from human role groups. Every live migration needs review, credentials, admission and separate approval.'
    engineer -> platform.authorization.api_owner '1. Review canonical platform/tenant groups, membership ownership and recovery; no user creation'
    platform.authorization.api_owner -> platform.authorization.groups '2. Offline Ansible renders disabled realm/clients; later API owner must read/compare and refuse conflicts'
    platform.authorization.groups -> platform.headlamp.runtime '3. Proposed Keycloak full-path claims; Headlamp/API issuer and audience both need verification'
    platform.headlamp.runtime -> platform.authorization.tenant_rbac '4. Kubernetes evaluates exact group bindings plus workload admission; tenant A cannot administer B'
    platform.authorization.groups -> platform.authorization.bao_policies '5. OpenBao: PA platform values/tenant names; TD own value read; consent/emergency still unimplemented'
    platform.authorization.groups -> platform.rancher.runtime '6. Rancher allows platform-admin group only; retain local break-glass, no tenant grants'
    platform.authorization.groups -> platform.authorization.storage_admin '7. Longhorn has no native OIDC RBAC; proxy/access decision remains blocked'
    platform.authorization.tenant_rbac -> engineer '8. Verify six roles, multi-tenant/client replay, query isolation and malicious workload/mapper deny cases before enabling'
    platform.authorization.bao_policies -> engineer '9. Verify native capabilities and revocation; everyday operator access uses platform-admin SSO'
    engineer -> custody '10. Keep durable local recovery in independent password-manager custody; bootstrap access may be temporary'
    custody -> engineer '11. Test local emergency access with SSO unavailable; custody stays off cluster; no live test claimed'
  }

  dynamic view keycloak_initial_admin {
    title 'Keycloak initial master administration — observed v0.14.0'
    description 'Who does what and why: observed deployment, scoped policies, TLS and private initial master login precede Ansible realm/group configuration. Temporary master admin does not expire; permanent independent recovery and retirement remain separate approvals. Frontend TLS terminates at Traefik; internal HTTP/PostgreSQL are plaintext.'
    link /runbook.html#keycloak-access 'Observed operation, source links and recovery boundary'
    engineer -> platform.prerequisite_applier '1. Review exact release/target; approve Longhorn claim, private credentials and current physical TLS'
    platform.prerequisite_applier -> platform.keycloak.installer '2. Ansible prepares 4Gi retained PVC, empty-store SQL, scoped installer rights and only two Keycloak NetworkPolicies'
    engineer -> platform.flux '3. Deliver approved leaf/bootstrap/database/Registry1 Secrets; retain v0.14.0, advance only local-keycloak path'
    platform.bigbang -> platform.keycloak.installer '4. Child waits for Longhorn and delegates chart operations to keycloak-installer'
    platform.keycloak.installer -> platform.keycloak.runtime '5. Helm creates database/app workloads without importing a realm or granting human roles'
    platform.keycloak.runtime -> platform.keycloak.master_admin '6. First empty-store start creates approved temporary master bootstrap identity'
    engineer -> platform.keycloak.master_admin '7. Passed trusted HTTPS, private master-admin API login, database role and per-node health/storage checks'
    platform.keycloak.master_admin -> engineer '8. Stop before realm/groups/clients/SSO; proposed Ansible configuration needs review and approval'
  }

  dynamic view headlamp_initial_admin {
    title 'Headlamp temporary-admin acceptance — observed v0.14.0'
    description 'Who does what and why: operator Ansible, delegated installer, unprivileged runtime and temporary human-equivalent bootstrap identity stay distinct. Test identity revoked; personal browser login unobserved. No ongoing access or SSO approval.'
    link /sources/headlamp-access-smoke.yaml 'Actual default-off Ansible operation'
    engineer -> platform.prerequisite_applier '1. Approve namespaced prerequisites and protected existing registry delivery'
    platform.prerequisite_applier -> platform.headlamp.installer '2. Apply chart/Helm-storage delegation only'
    engineer -> platform.flux '3. Keep v0.14.0 and advance only root to local-headlamp; Keycloak off'
    platform.headlamp.installer -> platform.headlamp.runtime '4. Helm deploys unprivileged UI; verify actual desired config and deployment Ready'
    engineer -> platform.headlamp.access_test '5. Establish localhost forwarding; explicitly approve temporary full admin and cleanup'
    platform.headlamp.access_test -> platform.headlamp.temporary_admin '6. Create unique SA/binding; TokenRequest 3600s, verify expiry, cache privately'
    platform.headlamp.temporary_admin -> platform.headlamp.runtime '7. Real cookie-login/proxy test with private token, no credential URLs/logs'
    platform.headlamp.runtime -> platform.rke2 '8. Prove dedicated identity and capabilities via safe reviews, no Secret values or destructive writes'
    platform.headlamp.access_test -> platform.headlamp.temporary_admin '9. Always UID-check/delete binding and SA; prove old token denied'
    platform.headlamp.runtime -> engineer '10. Close forwarding; verify retained apps/resources; personal browser and ongoing access remain separate'
  }

  dynamic view openbao_initial_admin {
    title 'OpenBao initialization and unseal — observed v0.13.0'
    description 'Who does what and why: observed approved 2026-11-01, code-linked one-time init/unseal, separate installer/runtime/root identities and temporary single-workstation recovery custody. No future initialization or recovery approval is conveyed.'
    link /sources/openbao-initialize.yaml 'Actual Ansible initialization/unseal source'
    engineer -> platform.prerequisite_applier '1. Review published release, target, capacity and current physical PKI; approve scoped actions'
    platform.prerequisite_applier -> platform.openbao.installer '2. Ansible applies namespaced installer/release-storage delegation, no cluster grants'
    engineer -> platform.flux '3. Deliver separately approved backend TLS Secret, then promote exact release'
    platform.flux -> platform.bigbang '4. Reconcile selected package; existing storage and Rancher unchanged'
    platform.bigbang -> platform.openbao.installer '5. HelmRelease selects delegated installer before rendering'
    platform.openbao.installer -> platform.openbao.runtime '6. Helm creates TLS server/SA and retained Longhorn claim; sealed state stays NotReady'
    engineer -> platform.openbao.initialization '7. Explicit apply: verify target and uninitialized store via TLS loopback; never reinitialize'
    platform.openbao.initialization -> platform.openbao.custody '8. Initialize once 3/2; save owner-only root token separately from shares before proceeding'
    platform.openbao.initialization -> platform.openbao.runtime '9. Submit two shares via stdin; verify unsealed health and initial root-token policy privately'
    platform.openbao.runtime -> engineer '10. Verify Ready and cluster resource delta; close port-forward; custody transfer/backup and OIDC remain pending'
  }

  dynamic view openbao_lan_https {
    title 'OpenBao LAN HTTPS — observed v0.14.0'
    description 'Who does what and why: TLS stays end to end; routing is not human authorization. Exact SNI only, no token/key forwarding configuration, global controller change or root-token login. Approved activation passed; future changes still require approval.'
    link /runbook.html#openbao-lan 'Approval, ownership and verification boundaries'
    engineer -> platform.prerequisite_applier '1. Approve exposure; verify exact target, published release, initialized store, TLS and existing routes'
    platform.prerequisite_applier -> platform.openbao.installer '2. Add only namespaced IngressRouteTCP CRUD; no cluster/Secret grant'
    engineer -> platform.flux '3. Conditional source promotion; preserve approved stage, no additional app selection'
    platform.openbao.installer -> platform.openbao.lan_route '4. Helm creates the exact-SNI route from pinned chart extraObjects'
    engineer -> platform.openbao.lan_route '5. Browser connects to exact hostname on existing 443; no automatic token login'
    platform.openbao.lan_route -> platform.openbao.runtime '6. Forward encrypted bytes to existing 8200; OpenBao alone terminates TLS'
    platform.openbao.runtime -> engineer '7. Verify CA/name/leaf and unauthenticated health/UI, Rancher route and resource report; stop on mismatch'
  }

  dynamic view rancher_local_admin {
    title 'Rancher installation observed — first login pending'
    description 'Observed at v0.12.0: root/umbrella/Rancher Ready, runtime controllers available and trusted HTTPS ping passed; no first login. Big Bang/Flux owns installation; Ansible applies approved prerequisites/TLS, not a competing Helm deployment. Vendor matrix covers RKE2 1.36 but lists Longhorn 1.12, not the separately managed 1.13 lab combination. One replica/control-plane is not HA. No SSO or test-volume cleanup.'
    link /runbook.html#rancher-stage 'Source, necessary inputs and acceptance gates'
    engineer -> platform.prerequisite_applier '1. Review new release, target/capacity, vendor gaps and privileged action scope'
    platform.prerequisite_applier -> platform.rancher.inputs '2. Separately approve namespace, checked TLS/public CA and bootstrap Secret delivery'
    platform.prerequisite_applier -> platform.rancher.installer '3. Apply versioned source/installer grants; runtime delegation is cluster-admin'
    engineer -> platform.flux '4. Promote exact published release only after inputs and prerequisites are ready'
    platform.flux -> platform.bigbang '5. Reconcile selected Rancher child; Longhorn remains unchanged'
    platform.bigbang -> platform.rancher.installer '6. Generated HelmRelease selects rancher-installer; helm-controller impersonates it'
    platform.rancher.installer -> platform.rancher.runtime '7. Helm creates runtime account/binding, server, hooks and TLS ingress'
    platform.rancher.runtime -> engineer '8. Verify readiness, trusted HTTPS and local-admin password reset; stop before SSO/lifecycle actions'
  }


  dynamic view realm_group_foundation {
    title 'PerkForge platform realm/groups — observed'
    description 'Who does what and why: observed platform-only operation created one realm/five empty groups with no users, memberships, custom mappings or app clients; repeat changed zero. Big Bang still owns deployment. Tenant roles and human/app authorization remain unimplemented; existing master recovery is preserved.'
    link /runbook.html#realm-foundation 'Operation, code, tests and boundaries'
    engineer -> platform.authorization.foundation '1. Approved platform-only input: empty tenant list; verified target/TLS and absent realm'
    platform.authorization.foundation -> platform.keycloak.master_admin '2. Verify target/TLS and authenticate existing master admin privately; do not create or retire credentials'
    platform.authorization.foundation -> platform.authorization.groups '3. Compare owned realm and every exact path/mapping; refuse conflicts before group writes'
    platform.authorization.foundation -> platform.keycloak.runtime '4. Created owned PerkForge realm and five empty platform/container groups; built-in scaffolding only'
    platform.keycloak.runtime -> platform.authorization.foundation '5. Verified zero users/members/custom mappings/app clients and second-run changed 0; existing apps/master preserved'
    platform.authorization.foundation -> engineer '6. Saved redacted evidence; stop before tenant groups, user enrollment, role enforcement or app SSO; permanent recovery remains separate'
  }

  dynamic view human_totp_enrollment {
    title 'IL2 named-human password/TOTP — draft, not executed'
    description 'Who does what and why: current IL2 TOTP is profile-scoped; future IL5 CAC is intended policy, not implemented. Proposed PerkForge browser-wide scope requires review. No live identity/flow or Headlamp changes.'
    link /runbook.html#human-totp 'Code, decisions and acceptance'
    engineer -> platform.authorization.human_enrollment '1. Review exact username, profile completion, IL2 scope and independent recovery; approve writes separately'
    platform.authorization.human_enrollment -> platform.keycloak.master_admin '2. Verify target/TLS; use existing protected master credential without changing recovery'
    platform.authorization.human_enrollment -> platform.keycloak.runtime '3. Check owned realm, account collisions, defaults and empty role mappings before any writes'
    platform.authorization.human_enrollment -> platform.keycloak.runtime '4. Build/verify owned browser policy: MFA SSO cookie OR required password plus required TOTP; bind only PerkForge'
    platform.authorization.human_enrollment -> platform.authorization.groups '5. Create one owned pending human and nominal platform-admin membership; no app/client/RBAC grants'
    engineer -> platform.keycloak.runtime '6. Human privately completes required profile/password/TOTP; no password, seed or QR enters automation/chat'
    platform.keycloak.runtime -> engineer '7. Require actual fresh wrong/missing-OTP denial and successful MFA/SSO; API flags alone are not acceptance'
    platform.authorization.human_enrollment -> engineer '8. Verify no-reset rerun/recovery; stop before bootstrap retirement, IL5 or separate Headlamp OIDC'
  }

}
