specification {
  element actor { style { shape person } }
  element system
  element component
  element boundary { style { color red } }
}

model {
  engineer = actor 'Platform operator' {
    description 'Selects the physical target, approves disk/data loss and access scope, operates firmware/installer and verifies trusted host identity. Enters credentials locally. This authorized human operator actor does not imply privileges for the proposed platform-engineer SSO group.'
    link /runbook.html#operator 'Operator responsibilities'
  }
  router = system 'Existing LAN router' {
    description 'Sole DHCP address allocator. Workstation proxy supplies boot information, never an address pool.'
    link /runbook.html#boot 'Boot protocol'
  }
  workstation = system 'Engineer workstation' {
    description 'Runs reviewed Ansible PXE lifecycle, dedicated boot/source services and SSH client. Existing system/libvirt services remain separate.'
    link /runbook.html#prepare 'Preparation and prerequisites'
    workspace = component 'Per-node private working directory' {
      description 'Ignored pxe/local/worker-x/runs/run workspace; mode0700 directories and0600 metadata/evidence. Tracked offline workspace.yml rebuilds fresh artifacts from backed-up nonsecret inputs without AI or live operations.'
      link /runbook.html#workspace 'Directory construction and artifact ownership'
      link /sources/workspace.yml 'Offline Ansible rebuild source'
      target_inputs = component 'Target inputs and provenance' {
        description 'Generated README and inputs.yml snapshot record confirmed node/network identity and source references. Extract only required nonsecret inventory fields; unresolved identity stays UNCONFIGURED. Credentials remain in protected custody.'
      }
      discovery = component 'Discovery configuration and lifecycle evidence' {
        description 'Retained rendered configuration, activation-review.yml hashes, generated standard session.sh caller and unique private logs/exit summaries. Root service state is separate; retained roots require reviewed preservation before reuse.'
      }
      access = component 'Per-run host trust and access evidence' {
        description 'Fresh access/handoff-* directory: untrusted host-key candidate, physical-console trust confirmation, pinned known_hosts, read-only inspection and step results. Historical per-run launchers are not required by the rebuild recipe. Existing private key referenced in custody, never copied here.'
      }
    }
    review = component 'Private target inputs and reviewed configuration' {
      description 'Target/network identity, verified media, boot paths, service identities and hashes. Ansible renders inert files into a fresh private review directory; review before activation.'
      link /sources/prepare.yml 'Transport preparation source'
      link /sources/inputs.example.yml 'Nonsecret input schema'
    }
    lifecycle = component 'Ansible activation / shutdown' {
      description 'Preflight, root-controlled copies, guard before LAN listeners, dedicated transient units and identity-checked rollback/shutdown. Runtime/log roots retained; existing roots cause stop for reviewed recovery.'
      link /runbook.html#lifecycle 'Lifecycle and recovery contract'
      link /sources/activate.yml 'Activation source'
      link /sources/shutdown.yml 'Shutdown source'
    }
    guard = component 'Dedicated nft ingress table' {
      description 'Restricts reviewed interface/client/ports before LAN binding. MAC/IP restrictions are spoofable, not authentication. Never edit unrelated tables.'
      link /sources/ingress.nft.j2 'Ingress template'
    }
    proxy = component 'Proxy DHCP / dnsmasq' {
      description 'Dedicated dnsmasq process supplies PXE boot metadata. Router keeps address allocation; system/libvirt dnsmasq identities are preserved.'
      link /sources/dnsmasq.conf.j2 'Proxy and TFTP template'
    }
    tftp = component 'Read-only TFTP boot tree' {
      description 'Vendor shim/GRUB, indefinite default-exit menu, kernel/initrd. Root-owned read-only media, reviewed hashes and a single GRUB lookup path.'
      link /sources/grub.cfg.j2 'GRUB menu template'
    }
    http = component 'nginx / read-only RHEL DVD tree' {
      description 'Full verified DVD tree including .treeinfo serves runtime/packages on reviewed TCP8080. Dedicated service identity/state. No passwords, hashes or private keys in served content.'
      link /sources/nginx.conf.j2 'HTTP template'
    }
    ssh = component 'SSH client / public-key enrollment' {
      description 'Shared access.sh requires physical-confirmed pinned host trust and existing key reference. Standard SSH tools enroll the public key, verify fresh access, transfer/hash the checked helper and prove a separate fresh key-only/password-sudo connection.'
      link /runbook.html#access 'Access handoff'
      link /sources/access.sh 'Shared handoff caller'
    }
    evidence = component 'Protected transaction and operational logs' {
      description 'Root-protected active record, config hashes, unit invocation identities and guard identity. Private automatic output/exit summary honors no_log and excludes terminal/password capture. Preserve failed attempts without overwriting.'
      link /runbook.html#lifecycle 'Evidence and ownership'
    }
  }
  node = system 'Selected physical node' {
    description 'Physical RHEL target. Repeat the process only for an explicitly selected node; preserve other installed nodes. Session status and approvals live in the handoff, not this model.'
    link /runbook.html#approve 'Target and erase review'
    firmware = component 'UEFI / boot selection' {
      description 'Retain Secure Boot. Prefer one-time wired IPv4 PXE; if interrupt is unreliable, temporarily put network first in Startup / Primary Boot Sequence. Record original order. Inspect Primary and Automatic Boot Sequence; restore disk-first in the relevant sequences and verify boot with Ethernet connected.'
      link /runbook.html#boot 'Firmware and restoration'
    }
    menu = component 'Indefinite GRUB menu' {
      description 'Default exit with timeout disabled. Reaching GRUB proves menu acceptance only, not a remote shell or disk inventory. Interactive installer selection is a separate approved action. Exit does not guarantee disk boot.'
      link /runbook.html#boot 'Menu acceptance'
    }
    installer = component 'RHEL Anaconda interactive installer' {
      description 'Minimal Install, reviewed hostname/wired networking, custom storage and root-disabled named administrator. Review only selected-disk changes before committing. Source stays available until installation finishes.'
      link /runbook.html#install 'Repeatable installation settings'
    }
    disk = component 'Reviewed system disk' {
      description 'For interactive single-disk install, review model/capacity/device and sole internal-drive status. Approve all data loss for this node. Device names are not persistent identity for automated disk erasure.'
      link /runbook.html#approve 'Disk identification and data loss'
    }
    os = component 'Installed RHEL / OpenSSH / sudo' {
      description 'Local-disk boot and trusted host identity precede public-key enrollment, key-only SSH verification and password-authenticated sudo. OS/access success does not establish RKE2 readiness.'
      link /runbook.html#verify 'Verification requirements'
    }
  }
  approval = boundary 'Target, exposure, erase and access scope' {
    description 'Review each new physical target. Approval for boot services, network boot, installer inspection, erase and access changes has distinct scope. Prior-node approval does not transfer.'
    link /runbook.html#approve 'Approval boundaries'
  }
  custody = system 'Protected credential custody / recovery' {
    description 'Private keys, passwords and recovery inputs remain protected outside served content and tracked files. Public key references only in nonsecret configuration.'
    link /runbook.html#access 'Trust and custody'
  }
  local_network = system 'Local wired LAN' {
    description 'Current physical inventory. Links represent SSH traffic over the shared LAN, not direct cables. Actual IP/MAC values remain in ignored local inventory; confirm DHCP/address assignments before reuse.'
    link /runbook.html#topology 'Local network topology'
    controller = component 'Workstation' {
      description 'Operator SSH and temporary PXE/HTTP serving host on the wired LAN.'
    }
    control_1 = component 'control-1' {
      description 'RHEL host assigned the RKE2 server/control-plane/etcd role.'
    }
    worker_1 = component 'worker-1' {
      description 'RHEL host assigned an RKE2 agent/workload role.'
    }
    worker_2 = component 'worker-2' {
      description 'RHEL host assigned an RKE2 agent/workload role.'
    }
  }
  platform = system 'Host readiness and platform ownership' {
    description 'Separate from OS installation. Infrastructure Ansible owns host/RKE2; platform Ansible owns gated Rancher API configuration. Flux owns Big Bang Longhorn/Rancher Helm deployments and GitOps and Big Bang supplies curated platform packages. Bootstrap stages the pinned Flux namespace and separately approved Registry1 pull Secret before controllers, with protected external inputs and clean published-release checks. Existing credentials are reused without reading local tokens; credential rotation is separate.'
    link /runbook.html#platform 'Platform responsibilities'
    readiness = boundary 'Host readiness / separate approval' {
      description 'Review repositories, Python, time, kernel prerequisites, networking/CNI, firewall, SELinux and capacity before cluster changes. Installed OS and working SSH alone are insufficient.'
    }
    rke2 = component 'Physical RKE2 cluster' {
      description 'One server with embedded etcd and two agents; not HA. Canal owns pod networking and Traefik handles ingress. SELinux remains enforcing. Infrastructure Ansible owns host preparation, pinned RPM install and serial joins. Separate server/agent tokens and admin kubeconfig remain in protected custody. Server token plus matching etcd snapshots are needed for recovery; node Ready is not backup validation.'
      link /runbook.html#rke2 'Cluster architecture and repeat process'
      server = component 'Single control-plane / embedded etcd server' {
        description 'Pinned RPM installation with enforcing SELinux; owns API, registration and datastore. Loss or reboot of this host interrupts the control plane; workers do not provide etcd quorum. Explicit worker-first reboot verification requires changed boot IDs, automatic service recovery and API/node readiness before continuing. It is limited to bootstrap-only workloads, not HA failover or production workload maintenance.'
      }
      agents = component 'Two serially joined worker agents' {
        description 'Run workloads and join using the shared separate agent-only token in secure format, without receiving the server token.'
      }
      networking = component 'Canal / CoreDNS / Traefik' {
        description 'Pod networking, cluster DNS and ingress. Client HTTPS terminates at Traefik using per-namespace Ingress TLS Secrets; authored Headlamp/Keycloak backends use HTTP. Public CA mounts separately support outbound HTTPS trust and do not enable backend encryption. OpenBao internal TLS remains separate. Local application suffix is perkforge.home.arpa: headlamp, keycloak, rancher and openbao use separate hostnames. The existing RKE2 Traefik DaemonSet binds host ports 80/443 on all three nodes; selecting a worker ingress address does not require a new load balancer but creates a worker availability dependency. BGW320-500 remains the household gateway/DHCP owner. Lab DNS is an installed, enabled DNS-only host service on control-1 outside Kubernetes, with four application records pointing to worker-1. LAN UDP/TCP and forwarding checks passed; actual service reboot recovery is untested. Workstation split DNS now routes lab queries via its existing loopback resolver to control-1 and other queries to the gateway; persistent NetworkManager DNS priority excludes gateway bypass without disabling IPv6. All three node resolvers now use control-1 directly with persistent DNS priority and successful host checks. CoreDNS completed an approved rolling refresh with two healthy replicas; lab UDP/TCP, internal service discovery and public forwarding passed through its service from control-1. Workload-specific/host-network DNS policies and API OIDC remain unverified. Local PKI issuance completed with an encrypted root and four separate one-year hostname server certificates in protected workstation custody. Independent offline backup is unconfirmed. Only the public CA is intended for trust stores and each service receives its own leaf/key; public OS CA trust is installed on the workstation/nodes with all16 leaf checks passed. Firefox was reopened and its active certificate-install policy confirmed by the operator; live browser HTTPS is unverified. Only the separately approved Rancher service key/leaf and public CA Secrets were delivered; the CA signing key stayed local. Application TLS delivery is prepared with separate namespace-only and credential gates, published clean source and exact-cluster checks. It creates Headlamp/Keycloak/Rancher leaf Secrets and Headlamp/Rancher public CA resources without RBAC, storage, routes or activation. Other app delivery and OpenBao internal TLS still require separate approval; authored URLs create neither records nor certificates. Host preparation persists modules/sysctls, excludes virtual interfaces from NetworkManager and explicitly disables firewalld for Canal compatibility. An explicit disposable two-worker smoke test checks DNS, cross-worker pod HTTP and ClusterIP access, then verifies owned namespace cleanup; it does not prove ingress or policy isolation.'
      }
      operator_access = component 'Private administrator kubeconfig' {
        description 'Mode0600 credentials with the reviewed API endpoint. Use the protected bundled client; default kubeconfig replacement requires an explicit operator request.'
      }
      recovery = component 'Server token and matching etcd snapshots' {
        description 'Keep protected off-node copies together for recovery. The explicit backup check creates a named snapshot, requires an unchanged server token, compares transfer size/SHA256 and validates the embedded integrity trailer without restart/restore. Exported tokens or their ZIP alone do not back up etcd. Byte integrity is separate from database consistency and restore validation. Etcd snapshots do not contain application PV data; that requires its own backup. The observed Keycloak database uses a retained 4Gi Longhorn PVC with two worker replicas; the static local-PV specimen is not deployed. Installed Big Bang Longhorn 1.13.0 package specifies two Longhorn replicas on distinct workers, initially around 80–100Gi logical capacity, no data replicas on control-1, bounded retention, independent backups and later dedicated worker disks. The first 1Gi disposable persistence/reattachment test passed; this is not HA or backup/restore proof. Read-only host audit confirms worker identity, XFS/shared propagation and capacity; approved iSCSI/module/service and directory preparation completed on both workers. SELinux stays enforcing; queried capability/socket rules are present, while exhaustive runtime/SELinux and recovery validation remain separate. Small-sample PVC I/O passed on both workers.'
      }
    }
    storage = component 'Longhorn application storage' {
      description 'OBSERVED: Longhorn 1.13.0, Big Bang and the root remain Ready at v0.13.0 after OpenBao activation. The first approved 1Gi persistence, recreation and cross-worker reattachment test passed with two healthy replicas. UI ingress stays absent; Rancher first installed at v0.12.0 remains Ready with first login pending; identity/tenants remain deferred. Recovery, backup/restore and cleanup need separate approval. A diagram authorizes no live action.'
      link /runbook.html#storage 'Storage ownership, rollout and testing'
      volumes = component 'Retained expandable application volumes' {
        description 'Nondefault StorageClass, two replicas, WaitForFirstConsumer. Keycloak depends on Longhorn and its alternate PVC overlay removes the old static PV binding. Observed OpenBao 10Gi claim is healthy with two worker replicas; future Harbor, portal and Nextcloud claims need explicit sizing.'
      }
      replica_pair = component 'Replicas on two distinct workers' {
        description 'Worker-only placement and disk labels exclude control-1 from application-data replicas. V1 engine, no overprovisioning, root-disk headroom and bounded snapshots; add dedicated disks as measured growth requires. One worker outage leaves a single surviving copy until rebuild.'
      }
      acceptance = component 'Approved Ansible storage smoke test' {
        description 'Workstation Ansible owns disposable namespace/PVC/pod changes; Python only verifies target/release, disk capacity and volume/replica state. One approved physical run passed. Saved 03:33 UTC evidence shows the final one-hour pod completed exit 0 at 03:03:42Z; retained volume is Detached/Unknown while inactive, not fresh active health proof. Default/check mode contacts no API. No attach/retest or automatic cleanup/repair.'
        link /sources/longhorn-storage-smoke.yaml 'Actual Ansible test entrypoint'
      }
      backups = component 'Independent application-data backups' {
        description 'Protect personal files, databases and secret recovery separately. Replication/Retain do not protect against deletion or corruption, and etcd snapshots do not contain PV contents. Independent custody and restore tests are required before relying on personal-data storage.'
      }
    }
    authorization = component 'Authorization design and gated foundation' {
      description 'FOUNDATION IMPLEMENTED/OFFLINE TESTED, NOT APPLIED: Ansible can create only owned realm and empty six-role group families; all memberships, app mappings and permissions remain proposed. Review rendering never applies. Existing pilot mappings are retained. Keycloak realm administration is distinct from Kubernetes/platform administration. Everyday operator access is intended through Keycloak platform-admin SSO. Durable local recovery credentials belong in the operator password manager, independent of cluster/Keycloak; test local emergency access with SSO unavailable. Temporary bootstrap credentials are not automatically durable recovery identities. Activation also requires admission/workload identity and custody decisions.'
      link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/README.md 'Who does what and why'
      groups = component 'Human groups and app clients — proposed' {
        description 'PerkForge display name/perkforge realm. One shared PerkForge realm; platform-admin/engineer/viewer and tenant-qualified admin/developer/viewer groups. Multiple tenant memberships grant only explicit scopes. Separate supported app clients/audiences; client-specific group disclosure and delegated membership mechanics remain proposed. No users or memberships created.'
        link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/templates/realm.yaml.j2 'Reviewable realm/group/client template'
      }
      api_owner = component 'Ansible realm/API configuration owner' {
        description 'Helm deploys apps; Ansible separately reviews/reconciles realm/groups/clients and native API settings. preview.yaml never authenticates/applies; existing OpenBao API configuration now additionally requires explicit platform_api_apply=true. No dual realm-import/API owners or unreviewed adoption.'
        link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/preview.yaml 'Actual offline Ansible review entrypoint'
      }
      foundation = component 'Default-off realm/group Ansible operation' {
        description 'IMPLEMENTED, NOT LIVE: foundation.yaml verifies target/TLS/private existing-master login, compares owned realm and exact paths, creates missing empty groups only, then reads back. Refuses adoption/role mappings/default inheritance; no users, memberships, clients, passwords or application permissions. Existing master recovery is preserved; engineer powers remain unsettled.'
        link /sources/realm-foundation.yaml 'Actual Ansible entrypoint'
        link /runbook.html#realm-foundation 'Who does what and why; approval and recovery gates'
      }
      tenant_rbac = component 'Kubernetes authorization and admission boundary — proposed' {
        description 'Exact oidc: group bindings: platform cluster-admin; tenant-qualified namespace roles; developer listed deployment-resource management plus own Secret get/list, no Secret writes/SA/token/exec; viewers status-only with no Secret API. Deployment edits can indirectly access mounted credentials or workload SAs. Restricted Pod Security/admission/identity/network controls are required before activation; RBAC alone is not isolation.'
        link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/templates/kubernetes.yaml.j2 'Disabled reviewable Kubernetes roles/bindings'
      }
      bao_policies = component 'OpenBao claim-bound roles and ACLs — proposed' {
        description 'Disabled exact group-bound review: PA edits platform KV values and LISTs tenant names, never standing tenant data read or auth/policy self-grant. TA manages own values; TD reads own values without writes; viewers proposed names-only. Root/unseal recovery separate. Cluster/identity administrators can bypass nominal app policy; consent/emergency elevation not implemented.'
      }
      roles = component 'Six human role scopes — intent' {
        pa = component 'Platform-admin' { description 'Cluster/platform and shared identity administration; platform values editable, tenant values only by explicit grant/emergency in nominal app policy. Powerful administrator bypass is acknowledged.' }
        pe = component 'Platform-engineer' { description 'Everyday platform code/MRs and proposed scoped diagnostics, not inherited admin. No global identity/RBAC/auth-policy, implicit secret-value or break-glass authority. GitOps protections, exact diagnostics and direct live writes remain decisions; no K8s/OpenBao grant is rendered.' }
        pv = component 'Platform-viewer' { description 'Read approved platform status, no operational mutation or secret values. No automatic access to tenant private data/chats.' }
        ta = component 'Tenant-admin' { description 'Own namespace/apps/secrets and allowlisted own group memberships. No cross-tenant privileges, global shared-user reset/deletion or platform elevation.' }
        td = component 'Tenant-developer' { description 'Own deployment-related resources and standing own secret-value read/list, never secret writes or permission changes.' }
        tv = component 'Tenant-viewer' { description 'Own status/reports, no operational changes or secret values. Ordinary messaging in assigned channels is allowed.' }
      }
      clients = boundary 'Per-app token and claim boundary' {
        description 'One realm is not one client. Each supported platform/tenant app needs an explicit audience/client and reviewed claims. Unsupported native protocols remain decisions, not fabricated OIDC clients. Wrong-client token replay must fail.'
      }
      ownership = boundary 'Tenant/resource enforcement and administrative trust' {
        description 'App APIs enforce namespace/org/project/tenant ownership independently of UI. Multiple memberships have explicit union, not global tenant administration. Shared identity/cluster administrators remain trusted bypass actors; least-standing access and emergency elevation need separate design.'
      }
      mappings = component 'Application-native role mappings — design' {
        keycloak = component 'Keycloak membership administration' {
          description 'PA shared user administration; TA only own allowlisted memberships, no shared-account reset/delete. TD/TV own profile. PV audit-only if explicitly supported. FGAP or broker mechanics unimplemented; fixed-image/security and adversarial tests required. PE: own profile, no identity administration.'
          link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/MATRIX.md 'Role matrix, implementation state and primary guidance'
        }
        kubernetes = component 'Kubernetes and Headlamp' {
          description 'Offline examples: PA cluster-admin bypass acknowledged; PV read status without Secret API; TA own namespace; TD own deployments/services/configmaps/ingresses and Secret get/list; TV own status only. Workload admission/SA controls and API OIDC remain acceptance gates. PE: proposed scoped diagnostics and GitOps MRs only; no rendered grant or agreed live-write scope.'
          link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/MATRIX.md 'Role matrix, implementation state and primary guidance'
        }
        rancher = component 'Rancher platform lifecycle' {
          description 'PA global administration only. PV read-only role is proposed, existing configurator admits PA only. No tenant roles or Fleet app ownership. Local recovery remains independent. PE: no default access; scoped diagnostic mapping needs review.'
          link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/MATRIX.md 'Role matrix, implementation state and primary guidance'
        }
        openbao = component 'OpenBao KV policy and elevation' {
          description 'Offline examples: PA platform values editable, tenant LIST metadata only; TA own values manage, TD own values read; viewers names-only proposed. No global sudo/self-grant. Tenant consent/emergency, mount migration and real capability tests unimplemented. PE: no default secret values or policy-management grant; explicit per-path decision required.'
          link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/MATRIX.md 'Role matrix, implementation state and primary guidance'
        }
        longhorn = component 'Longhorn storage administration' {
          description 'PA entry only through a later verified proxy/access choice. No native password/OIDC/group RBAC. PV safe read-only route undecided; tenants no storage-admin UI. UI ingress remains off. PE: proposed metrics/diagnostics, no admin UI or volume mutations.'
          link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/MATRIX.md 'Role matrix, implementation state and primary guidance'
        }
        grafana = component 'Grafana organization and query access' {
          description 'Design: PA explicit server admin; PV explicit org Viewer; TA own org Admin; TD Editor; TV Viewer. Tenant-scoped backend datasources required; folder ACLs are not query isolation. OSS org mapping differs from Enterprise Team Sync; no global role escalation via multi-org membership. PE: proposed scoped platform-org Viewer and dashboard MRs; no server administration.'
          link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/MATRIX.md 'Role matrix, implementation state and primary guidance'
        }
        mattermost = component 'Mattermost team and channel membership' {
          description 'Design: PA System Admin; TA own Team Admin; PV/TD/TV assigned ordinary Member, chat allowed. No automatic private-channel visibility. Verify pinned 11.11 edition/OIDC entitlement; group claims are not native team-role synchronization. No assumed 12.1 ABAC. PE: ordinary assigned member, no team/system administration.'
          link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/MATRIX.md 'Role matrix, implementation state and primary guidance'
        }
        gitlab = component 'GitLab group/project authorization' {
          description 'Design: PA explicit instance admin; TA own group Owner; TD own project Developer; TV Reporter/read access; PV explicit memberships only. Free OIDC login does not include paid group-derived admin/auditor controls or automatic group memberships. API reconciliation and CI-secret scope pending. PE: Developer on approved platform-code projects for MRs, no instance administration; protected ownership reviews required.'
          link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/MATRIX.md 'Role matrix, implementation state and primary guidance'
        }
        harbor = component 'Harbor private projects' {
          description 'Design: PA system admin only; TA own Project Admin; TD own Developer push/pull; TV Guest pull; PV explicit project read-only scope. OIDC groups map native project roles, not tenant groups to system admin. Robot identities/migration separately reviewed. PE: explicitly approved build-project scope only, no blanket registry/robot credential access.'
          link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/MATRIX.md 'Role matrix, implementation state and primary guidance'
        }
        sonarqube = component 'SonarQube project permissions' {
          description 'Design: PA System Admin; TA own project administrator; TD scoped analysis/issue capabilities; TV/PV approved project Browse. Community Build native generic Keycloak OIDC is not established; supported SAML/GitLab/header or edition decision pending. No paid MR-analysis promise. PE: approved project analysis/Browse only, no system administration.'
          link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/MATRIX.md 'Role matrix, implementation state and primary guidance'
        }
        portal = component 'Tenant portal example — API enforcement' {
          description 'Observed code at portal89f3637 checks issuer/audience/client/RS256 and tenant-reader plus home/platform group for tenant listing. Full six-role administration/mutations and generalized tenant ownership are NOT implemented. Per-app access token and server resource checks required; hidden UI is not security. PE: code/MRs and approved diagnostics, no implicit portal business-data or tenant-admin access.'
          link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/MATRIX.md 'Role matrix, implementation state and primary guidance'
        }
        nextcloud = component 'Nextcloud tenant app example' {
          description 'Design only: own tenant instance/app client and native file/share/group scopes. TA is not shared-server super-admin. TD/TV business data follows explicit shares, not Kubernetes role names. Supported version/backend/edition must be inspected before implementation. PE: approved code/config MRs, no implicit tenant file/share access.'
          link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/MATRIX.md 'Role matrix, implementation state and primary guidance'
        }
        prometheus = component 'Prometheus query boundary' {
          description 'Machine scrape identity and reviewed Grafana query access; no standing direct tenant mutation/API grant. Cross-tenant query separation needs enforcement, not namespace labels. Human app roles do not become collector credentials. PE diagnostics require explicit query scope, not broad store access.'
          link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/MATRIX.md 'Role matrix, implementation state and primary guidance'
        }
        loki = component 'Loki ingest and query boundary' {
          description 'Machine ingest identity and trusted tenant-scoped query/headers/proxy. Collector namespace opt-in is not tenant data authorization. Grafana Viewer must not query a platform-wide datasource. Live isolation/retention tests pending. PE diagnostics require explicit query scope, not tenant log access by default.'
          link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/MATRIX.md 'Role matrix, implementation state and primary guidance'
        }
        alloy = component 'Alloy collector identity' {
          description 'Machine SA/token with reviewed discovery/log scope, redaction and egress. No human role inherits collector credentials. Draft collector scope is not tenant RBAC isolation. PE may propose config MRs; collector credentials are not inherited.'
          link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/MATRIX.md 'Role matrix, implementation state and primary guidance'
        }
        alerts = component 'Alertmanager and ntfy routing' {
          description 'Machine notification sender versus approved recipients/topic subscribers. Native rules retained; Grafana-managed forwarding/ntfy bridge off and unimplemented. No unauthenticated alert mutation/publish or invented native OIDC. PE may propose routing/rule MRs; publishing/mutation credentials remain separate.'
          link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/MATRIX.md 'Role matrix, implementation state and primary guidance'
        }
        velero = component 'Velero recovery operator — ticket only' {
          description 'Separate scoped backup/restore identity and off-cluster credential custody. Backups contain Secrets; tenant restore cannot overwrite others or race Flux. Evaluation only, no deployment or grants. PE receives no backup/restore or backup-secret authority by default.'
          link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/MATRIX.md 'Role matrix, implementation state and primary guidance'
        }
        trivy = component 'Trivy scanner — evaluation only' {
          description 'Machine scan identity for approved registries/images; report access follows project policy. No global pull credential or cross-tenant report access inherited by human viewer roles. PE receives no blanket scan/registry credentials by default.'
          link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/MATRIX.md 'Role matrix, implementation state and primary guidance'
        }
        traffic = component 'Istio and Gateway API — ticket only' {
          description 'Future explicit platform network administration and constrained delegated tenant routes/listeners/references. No controller, CRD, gateway or route implementation in this authorization draft. PE may propose network-config MRs; direct control-plane writes remain undecided.'
          link https://github.com/perkforge/perkforge-platform/blob/feat/authorization-proposal/big-bang-bootstrap/configuration/authorization/MATRIX.md 'Role matrix, implementation state and primary guidance'
        }
      }
      storage_admin = component 'Longhorn admin entry boundary — undecided' {
        description 'No native password/OIDC/group RBAC. Ingress stays off. Verify an existing Rancher proxy path or choose an external authenticated platform-admin-only proxy later; no tenant storage administration or fabricated client.'
      }
    }
    keycloak = component 'Keycloak identity server — observed' {
      description 'OBSERVED v0.14.0: compatible chart 7.3.2-bb.1 with verified immutable Iron Bank 26.8.1 image override (chart appVersion metadata remains 26.8.0), plus PostgreSQL on a retained 4Gi Longhorn claim with two healthy worker replicas. Ready and trusted HTTPS/private master-admin login/non-superuser DB access passed. Traefik terminates TLS; HTTP and PostgreSQL are unencrypted inside the cluster under two reviewed NetworkPolicies. One app/database, not HA. No PerkForge realm/groups/clients or app OIDC activation.'
      link https://github.com/perkforge/perkforge-platform/blob/fix/keycloak-security-patch/big-bang-bootstrap/configuration/packages/keycloak/README.md 'Initial Keycloak procedure'
      installer = component 'keycloak-installer — namespaced Helm identity' {
        description 'Ansible prepares namespace/PVC/init ConfigMap; Helm manages namespaced app/database resources. Only named database Secret get lookups, no cluster RBAC or human grants. Credentials and current physical TLS remain separate approved delivery.'
      }
      runtime = component 'Keycloak/PostgreSQL workload identities' {
        description 'Application and database roles are separate from human Keycloak administration and Kubernetes/tenant roles. Application DB user is not database superuser. Helm does not own realm API configuration.'
      }
      master_admin = component 'Temporary master bootstrap administrator' {
        description 'OBSERVED Secret-backed temporary master identity; private login/read-only API passed. First-start only; does not expire automatically. Owner-only temporary custody is not permanent recovery. Master realm recovery/admin does not automatically imply PerkForge platform-admin membership or vice versa. Removal requires verified permanent recovery and separate approval.'
      }
    }
    headlamp = component 'Headlamp Kubernetes identity UI — observed' {
      description 'OBSERVED v0.14.0: Ready, cookie login/proxy verified using approved dedicated one-hour admin identity, then SA/binding deleted and token denied. Personal browser login not observed. Runtime remains unprivileged; no native admin password, persistent admin SA, ingress or OIDC. New access needs approval.'
      link /runbook.html#headlamp-access 'Token-mode procedure and identity decision'
      installer = component 'headlamp-installer — delegated Helm identity' {
        description 'Ansible installs namespaced chart and Helm-storage permissions, separately gated Registry1 delivery. Installer can create Deployment/Service/runtime SA, not human or cluster RBAC.'
      }
      access_test = component 'Workstation gated Ansible access test' {
        description 'Observed: default-off headlamp-access-smoke.yaml created unique temporary admin identity, verified real cookie login/API safely and always UID-guarded cleanup. Runtime/installer are separate; no workload writes or Secret value reads. Operator runner supplied/closed loopback forwarding.'
        link /sources/headlamp-access-smoke.yaml 'Actual Ansible operation'
        link /sources/headlamp-access-cleanup.yaml 'UID-guarded cleanup'
        link /sources/verify-headlamp-access.py 'Actual identity, expiry, API and revocation verifier'
      }
      temporary_admin = component 'One-hour bootstrap SA/token — revoked' {
        description 'Observed exception approved separately: dedicated SA binding to existing cluster-admin; TokenRequest actual lifetime checked and custody owner-only. Both objects removed, old token denied. Not persistent access, a native password, a six-role mapping or proof of personal browser login.'
      }
      runtime = component 'Headlamp runtime SA — no application RBAC' {
        description 'UI forwards the human token; Kubernetes authenticates/authorizes it. Unsafe service-account token use and chart cluster-role binding are disabled. Prior proven OIDC group mappings are retained only for later review.'
      }
    }
    openbao = component 'OpenBao initial token administration — observed' {
      description 'OBSERVED v0.13.0: official chart 0.30.6/OpenBao 2.7.2, initialized once 3 shares / threshold 2, unsealed and initial root-token access verified. One TLS-required worker server, Longhorn-backed 10Gi PebbleDB; separately approved v0.14.0 LAN passthrough accepted, no injector/Kubernetes auth delegation or automatic init/unseal. No HA. Preserved pilot OIDC policies are not activated. Sealed/uninitialized is NotReady, not accepted.'
      link https://github.com/perkforge/perkforge-platform/blob/feat/openbao-bootstrap/big-bang-bootstrap/configuration/packages/openbao/README.md 'OpenBao source and activation gates'
      lan_route = component 'Exact-SNI TCP passthrough — observed v0.14.0' {
        description 'OBSERVED: Helm extraObjects owns one IngressRouteTCP for openbao.perkforge.home.arpa on existing websecure to openbao:8200. Browser TLS terminates only at OpenBao, verifies current CA/name; no extra key copy or Traefik token/TLS termination. Other SNI falls through to existing HTTP routers. Trusted LAN UI/health/leaf and unchanged Rancher route passed; no root-token browser login or human/OIDC role grant.'
        link https://github.com/perkforge/perkforge-platform/blob/feat/openbao-lan-tls/big-bang-bootstrap/configuration/packages/openbao/values.yaml 'Chart-owned route values'
      }
      initialization = component 'Workstation one-time Ansible initialization' {
        description 'OBSERVED: disabled-by-default openbao-initialize.yaml checked target, fresh custody and uninitialized status through verified TLS loopback; initialized 3/2 once, persisted private recovery, submitted two shares via stdin, verified root-token lookup-self. Never an automatic restart/recovery operation.'
        link /sources/openbao-initialize.yaml 'Executed Ansible source'
      }
      custody = component 'Temporary owner-only root and unseal custody' {
        description 'Root token and all three unseal shares are separate subdirectories on one workstation. This is temporary single-location custody, not independent holders or backup. Operator migration/cleanup and scoped recovery remain pending; no values in Git or logs.'
      }
      installer = component 'openbao-installer — namespaced Helm identity' {
        description 'Administrator-applied Ansible prerequisite creates this bigbang service account and namespaced chart/release-storage bindings. No cluster RBAC, bind/escalate or Kubernetes-auth delegation; app root cannot grant its own installer authority. Candidate adds only namespaced ingressroutetcps CRUD before any later promotion.'
      }
      runtime = component 'openbao runtime account and sealed server' {
        description 'Chart creates a non-root server account without a persistent SA token or RoleBinding. Initial human admin uses an approved bearer token, not a password. Unseal shares are separate recovery custody; later OIDC group-to-policy mappings remain gated Ansible API configuration.'
      }
    }
    rancher = component 'Rancher cluster lifecycle administration' {
      description 'OBSERVED: Rancher 2.15.2 server/controllers and root Ready at v0.12.0; trusted HTTPS passed, first login/password setup NOT attempted. Big Bang/Flux owns Helm. One replica, strict private-CA TLS, no application PVC. Reviewed release, capacity, TLS/bootstrap inputs and privileged installer approval precede promotion. No Keycloak/SSO/groups/roles changes; direct RKE2 recovery remains independent.'
      link /runbook.html#rancher-stage 'Rancher local-admin stage and approval gates'
      runtime = component 'Rancher local-admin server and core controllers' {
        description 'OBSERVED: server, webhook, fleet-controller and helmops deployments available; Continuous Delivery remains off. Trusted HTTPS ping passed. No local-admin login or password setup has been attempted.'
      }
      inputs = component 'Protected TLS and bootstrap references' {
        description 'OBSERVED separately approved Rancher-only delivery: cattle-system current physical leaf/key and public CA Secrets; bigbang rancher-bootstrap-values contains a nonempty privately cached bootstrapPassword. No signing key, plaintext Git value or credential URL. That historical Rancher batch delivered no other app credential or CA signing key; later separately approved OpenBao backend TLS delivery is shown in its own flow.'
      }
      installer = component 'Delegated Rancher installer and runtime trust' {
        description 'Ansible applies reviewed prerequisites; helm-controller uses bigbang:rancher-installer. Chart binds cattle-system:rancher to cluster-admin and uses a named pre-upgrade hook role. This is administrative trust, not least privilege. Optional destructive post-delete hook is off; uninstall is separately reviewed.'
        link https://github.com/perkforge/perkforge-platform/blob/main/big-bang-bootstrap/configuration/packages/rancher/prerequisites/installer.yaml 'Rancher installer prerequisite source'
      }
    }
    flux = component 'Flux GitOps reconciliation' {
      description 'CURRENT: reconciles the explicitly selected immutable configuration tag. Publishing a release does not promote the running source or approve activation. The ordinary application root has no direct RBAC-management authority. DEFERRED: evaluate a separately bootstrapped, scoped foundation and release/promotion simplification after cluster stability; issues #95 and #14. No self-grant by the application root.'
      link /runbook.html#bootstrap-ownership 'Installer ownership and release promotion'
    }
    bigbang = component 'Big Bang platform packages' {
      description 'CURRENT: Helm renders selected packages after versioned installer prerequisites are separately approved and applied by Ansible. Chart lookups may need permissions before rendering; values cannot grant their own pre-render authority. Runtime chart RBAC is separate from installer delegation. This is an ownership choice, not a requirement that all prerequisites remain outside GitOps.'
      link /runbook.html#bootstrap-ownership 'Pre-render prerequisite boundary'
    }
    prerequisite_applier = component 'Approved prerequisite Ansible actor' {
      description 'Operator-approved shared and per-package prerequisite playbooks apply versioned Kubernetes RBAC using protected external target access. This actor applies grants; it is not their recipient. No live apply is authorized by this model.'
      link https://github.com/perkforge/perkforge-platform/blob/main/big-bang-bootstrap/configuration/ansible/longhorn-prerequisites.yaml 'Prerequisite playbook'
    }
    longhorn_installer = component 'Helm installer identity' {
      description 'bigbang:longhorn-installer is selected by the child HelmRelease serviceAccountName. Helm-controller uses impersonation for chart operations. Named bind on cluster-admin permits the upstream diagnostic delegation; the installer is not itself bound to cluster-admin. This is an explicit trusted-infrastructure lab decision, not least privilege.'
      link https://github.com/perkforge/perkforge-platform/blob/main/big-bang-bootstrap/configuration/packages/longhorn/prerequisites/installer.yaml 'Versioned installer RBAC'
    }
    longhorn_runtime = component 'Longhorn runtime identities' {
      description 'Helm creates separate manager, CSI, UI and support-bundle accounts/bindings. Support-bundle receives cluster-admin; manager longhorn-role already has wildcard ClusterRole/ClusterRoleBinding verbs. UI ingress remains disabled. The separately approved v0.11.3 named grant and single child/umbrella resets completed; all are Ready. Further grants or retries still require approval.'
      link /runbook.html#longhorn-rbac 'Lab trust and observed stopping point'
    }
    enrollment = component 'Tenant enrollment repository' {
      // Not selected in the local root until core platform readiness.
      description 'Owns tenant foundations and registration.'
    }
    applications = component 'Application repositories' {
      description 'Own application configuration and tenant deployments.'
    }
  }

