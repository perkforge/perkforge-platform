# Opt-in fork only. Not selected by any root. Token never appears in this template.
log: {level: warn, format: json}
server:
  listen_address: '127.0.0.1:8080'
  enable_pprof: false
  metrics: {enabled: true}
  webhook: {enabled: false}
gitlab:
  url: {{ gitlab_url | to_json }}
  enable_tls_verify: true
  enable_health_check: false
  maximum_requests_per_second: 1
  burstable_requests_per_second: 2
redis: {url: ''}
opentelemetry: {grpc_endpoint: ''}
pull:
  projects_from_wildcards: {on_init: false, scheduled: false}
  metrics: {on_init: false, scheduled: false}
garbage_collect:
  projects: {on_init: false, scheduled: false}
  environments: {on_init: false, scheduled: false}
  refs: {on_init: false, scheduled: false}
  metrics: {on_init: false, scheduled: false}
project_defaults:
  pull:
    environments: {enabled: false}
    refs:
      branches: {enabled: true, regexp: '^$'}
      tags: {enabled: false}
      merge_requests: {enabled: false}
    pipeline:
      variables: {enabled: false}
      test_reports: {enabled: false, test_cases: {enabled: false}}
      jobs:
        enabled: false
        from_child_pipelines: {enabled: false}
        runner_description: {enabled: false}
wildcards: []
projects:
{% for project, targets in snapshot_targets | groupby('project') %}
  - name: {{ project | to_json }}
    pull:
      refs:
        branches:
          enabled: true
          regexp: {{ ('^(' + (targets | map(attribute='ref') | map('regex_escape') | join('|')) + ')$') | to_json }}
{% endfor %}
pipeline_snapshot:
  enabled: {{ snapshot_enabled | to_json }}
  interval_seconds: {{ interval_seconds }}
  timeout_seconds: {{ timeout_seconds }}
  targets:
{% for t in snapshot_targets %}
    - project_id: {{ t.project_id }}
      project: {{ t.project | to_json }}
      ref: {{ t.ref | to_json }}
      source: {{ t.source | to_json }}
{% endfor %}
