{%- macro healthy(t) -%}
(min(gcpe_pipeline_snapshot_valid{ {{ selector(t) }} }) == bool 1)
* (count(gcpe_pipeline_snapshot_valid{ {{ selector(t) }} }) == bool 1)
* (min(gcpe_pipeline_snapshot_observation_age_seconds{ {{ selector(t) }} }) >= bool 0)
* (max(gcpe_pipeline_snapshot_observation_age_seconds{ {{ selector(t) }} }) <= bool {{ freshness_seconds }})
* (count(gcpe_pipeline_snapshot_observation_age_seconds{ {{ selector(t) }} }) == bool 1)
