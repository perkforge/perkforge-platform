new file mode 100644
index 0000000000000000000000000000000000000000..3254e1bcc7e246944a1efb83b4c0c6b7334b200c
--- /dev/null
+++ b/pkg/snapshot/yaml.go
@@ -0,0 +1,44 @@
+package snapshot
+
+import (
+	"errors"
+	"gopkg.in/yaml.v3"
+)
+
+// Unknown opt-in fields are rejected instead of silently enabling the legacy path.
+func (c *Config) UnmarshalYAML(n *yaml.Node) error {
+	if n.Kind != yaml.MappingNode {
+		return errors.New("snapshot config must be mapping")
+	}
+	keys := map[string]bool{"enabled": true, "interval_seconds": true, "timeout_seconds": true, "targets": true}
+	for i := 0; i < len(n.Content); i += 2 {
+		if !keys[n.Content[i].Value] {
+			return errors.New("unknown snapshot field")
+		}
+	}
+	type plain Config
+	var p plain
+	if err := n.Decode(&p); err != nil {
+		return err
+	}
+	*c = Config(p)
+	return nil
+}
+func (t *Target) UnmarshalYAML(n *yaml.Node) error {
+	if n.Kind != yaml.MappingNode {
+		return errors.New("snapshot target must be mapping")
+	}
+	keys := map[string]bool{"project_id": true, "project": true, "ref": true, "source": true}
+	for i := 0; i < len(n.Content); i += 2 {
+		if !keys[n.Content[i].Value] {
+			return errors.New("unknown snapshot target field")
+		}
+	}
+	type plain Target
+	var p plain
+	if err := n.Decode(&p); err != nil {
+		return err
+	}
+	*t = Target(p)
+	return nil
+}
