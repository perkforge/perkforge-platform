diff --git a/pkg/snapshot/snapshot.go b/pkg/snapshot/snapshot.go
new file mode 100644
index 0000000000000000000000000000000000000000..90e98a79a032c0251a79ba1fd4d81f6a591001d8
--- /dev/null
+++ b/pkg/snapshot/snapshot.go
@@ -0,0 +1,279 @@
+// Package snapshot is an opt-in, bounded, in-memory pipeline observation prototype.
+// It deliberately does not read or write the legacy metric store.
+package snapshot
+
+import (
+	"context"
+	"crypto/tls"
+	"errors"
+	"fmt"
+	"golang.org/x/time/rate"
+	"net/http"
+	"net/url"
+	"regexp"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/prometheus/client_golang/prometheus"
+	gl "gitlab.com/gitlab-org/api/client-go"
+)
+
+type Target struct {
+	ProjectID int64  `yaml:"project_id"`
+	Project   string `yaml:"project"`
+	Ref       string `yaml:"ref"`
+	Source    string `yaml:"source"`
+}
+type Config struct {
+	Enabled         bool     `yaml:"enabled"`
+	IntervalSeconds int      `yaml:"interval_seconds"`
+	TimeoutSeconds  int      `yaml:"timeout_seconds"`
+	Targets         []Target `yaml:"targets"`
+}
+
+var pathRE = regexp.MustCompile(`^[a-zA-Z0-9_-]+(/[a-zA-Z0-9_.-]+)+$`)
+var refRE = regexp.MustCompile(`^[a-zA-Z0-9_-][a-zA-Z0-9_./-]{0,127}$`)
+
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+	if c.IntervalSeconds < 15 || c.IntervalSeconds > 300 || c.TimeoutSeconds < 1 || c.TimeoutSeconds > 30 || c.TimeoutSeconds >= c.IntervalSeconds || len(c.Targets) < 1 || len(c.Targets) > 16 || len(c.Targets)*c.TimeoutSeconds > c.IntervalSeconds {
+		return errors.New("snapshot bounds invalid")
+	}
+	seen := map[string]bool{}
+	ids := map[int64]string{}
+	paths := map[string]int64{}
+	for _, t := range c.Targets {
+		key := fmt.Sprintf("%d/%s/%s", t.ProjectID, t.Ref, t.Source)
+		if t.ProjectID <= 0 || len(t.Project) > 200 || !pathRE.MatchString(t.Project) || !refRE.MatchString(t.Ref) || strings.Contains(t.Ref, "..") || strings.Contains(t.Ref, "//") || strings.HasSuffix(t.Ref, "/") || strings.HasSuffix(t.Ref, ".lock") || t.Source != "push" || seen[key] {
+			return errors.New("snapshot target invalid")
+		}
+		if p, ok := ids[t.ProjectID]; ok && p != t.Project {
+			return errors.New("snapshot project collision")
+		}
+		if id, ok := paths[t.Project]; ok && id != t.ProjectID {
+			return errors.New("snapshot path collision")
+		}
+		seen[key] = true
+		ids[t.ProjectID] = t.Project
+		paths[t.Project] = t.ProjectID
+	}
+	return nil
+}
+
+type observation struct {
+	valid, present bool
+	status         string
+	generation     uint64
+	success        time.Time
+}
+type slot struct {
+	poll  sync.Mutex
+	value observation
+}
+type Collector struct {
+	cfg    Config
+	client *gl.Client
+	mu     sync.RWMutex
+	slots  []*slot
+	now    func() time.Time
+	desc   map[string]*prometheus.Desc
+}
+
+// New accepts a CA-rooted transport for tests/private PKI, never an insecure TLS transport.
+func New(c Config, origin, token string, transport *http.Transport, requestsPerSecond, burst int) (*Collector, error) {
+	if err := c.Validate(); err != nil {
+		return nil, err
+	}
+	if requestsPerSecond < 1 || requestsPerSecond > 10 || burst < 1 || burst > 10 {
+		return nil, errors.New("snapshot rate bounds invalid")
+	}
+	if !c.Enabled {
+		return nil, errors.New("snapshot disabled")
+	}
+	u, err := url.Parse(origin)
+	if err != nil || u.Scheme != "https" || u.Host == "" || u.User != nil || u.RawQuery != "" || u.Fragment != "" || (u.Path != "" && u.Path != "/") || strings.TrimSpace(token) == "" || strings.ContainsAny(token, "\r\n") {
+		return nil, errors.New("snapshot origin or credential invalid")
+	}
+	if transport == nil {
+		transport = http.DefaultTransport.(*http.Transport).Clone()
+	} else {
+		transport = transport.Clone()
+	}
+	if transport.TLSClientConfig != nil && transport.TLSClientConfig.InsecureSkipVerify {
+		return nil, errors.New("snapshot TLS verification required")
+	}
+	if transport.TLSClientConfig == nil {
+		transport.TLSClientConfig = &tls.Config{MinVersion: tls.VersionTLS12}
+	} else {
+		transport.TLSClientConfig = transport.TLSClientConfig.Clone()
+		transport.TLSClientConfig.MinVersion = tls.VersionTLS12
+	}
+	transport.Proxy = nil // Do not forward credentials through environment-selected proxies.
+	hc := &http.Client{Transport: &originTransport{base: transport, origin: u.Host, limiter: rate.NewLimiter(rate.Limit(requestsPerSecond), burst)}, Timeout: time.Duration(c.TimeoutSeconds) * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return errors.New("snapshot redirects denied") }}
+	client, err := gl.NewClient(token, gl.WithHTTPClient(hc), gl.WithBaseURL(strings.TrimSuffix(origin, "/")+"/api/v4"), gl.WithoutRetries())
+	if err != nil {
+		return nil, errors.New("snapshot client invalid")
+	}
+	c.Targets = append([]Target(nil), c.Targets...) // Caller cannot mutate the allowlist after validation.
+	x := &Collector{cfg: c, client: client, now: time.Now, desc: map[string]*prometheus.Desc{}}
+	for range c.Targets {
+		x.slots = append(x.slots, &slot{})
+	}
+	for _, n := range []string{"valid", "present", "last_success_timestamp_seconds", "observation_age_seconds", "generation"} {
+		x.desc[n] = prometheus.NewDesc("gcpe_pipeline_snapshot_"+n, "Bounded pipeline observation "+n, []string{"project_id", "project", "ref", "source"}, nil)
+	}
+	x.desc["status"] = prometheus.NewDesc("gcpe_pipeline_snapshot_status", "Historical status; authoritative only when valid and fresh", []string{"project_id", "project", "ref", "source", "status"}, nil)
+	return x, nil
+}
+func (c *Collector) Describe(ch chan<- *prometheus.Desc) {
+	for _, d := range c.desc {
+		ch <- d
+	}
+}
+func bit(b bool) float64 {
+	if b {
+		return 1
+	}
+	return 0
+}
+func (c *Collector) Collect(ch chan<- prometheus.Metric) {
+	c.mu.RLock()
+	values := make([]observation, len(c.slots))
+	for i, s := range c.slots {
+		values[i] = s.value
+	}
+	now := c.now()
+	c.mu.RUnlock()
+	for i, v := range values {
+		t := c.cfg.Targets[i]
+		labels := []string{strconv.FormatInt(t.ProjectID, 10), t.Project, t.Ref, t.Source}
+		age := -1.0
+		stamp := 0.0
+		if !v.success.IsZero() {
+			age = now.Sub(v.success).Seconds()
+			stamp = float64(v.success.Unix())
+		}
+		// Monotonic age and wall-clock ordering must both be plausible. Never trust a future timestamp.
+		wallAge := now.Round(0).Sub(v.success.Round(0)).Seconds()
+		valid := v.valid && freshAges(age, wallAge, float64(c.cfg.IntervalSeconds*3))
+		for n, val := range map[string]float64{"valid": bit(valid), "present": bit(v.present), "last_success_timestamp_seconds": stamp, "observation_age_seconds": age, "generation": float64(v.generation)} {
+			ch <- prometheus.MustNewConstMetric(c.desc[n], prometheus.GaugeValue, val, labels...)
+		}
+		for _, s := range []string{"failed", "success", "other"} {
+			ch <- prometheus.MustNewConstMetric(c.desc["status"], prometheus.GaugeValue, bit(v.status == s), append(labels, s)...)
+		}
+	}
+}
+
+// Poll serializes a ref's complete observation; rejected/canceled work cannot publish valid data.
+func (c *Collector) Poll(ctx context.Context, i int) error {
+	if i < 0 || i >= len(c.slots) {
+		return errors.New("snapshot target out of bounds")
+	}
+	s := c.slots[i]
+	s.poll.Lock()
+	defer s.poll.Unlock()
+	c.mu.Lock()
+	s.value.valid = false
+	s.value.generation++
+	gen := s.value.generation
+	start := c.now()
+	c.mu.Unlock()
+	ctx, cancel := context.WithTimeout(ctx, time.Duration(c.cfg.TimeoutSeconds)*time.Second)
+	defer cancel()
+	present, status, err := c.fetch(ctx, c.cfg.Targets[i])
+	if err != nil {
+		return errors.New("snapshot observation failed")
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	now := c.now()
+	if ctx.Err() != nil || !freshAges(now.Sub(start).Seconds(), now.Round(0).Sub(start.Round(0)).Seconds(), float64(c.cfg.TimeoutSeconds)) || (!s.value.success.IsZero() && now.Unix() < s.value.success.Unix()) || s.value.generation != gen {
+		return errors.New("snapshot observation invalidated")
+	}
+	s.value = observation{valid: true, present: present, status: status, generation: gen, success: now}
+	return nil
+}
+func (c *Collector) fetch(ctx context.Context, t Target) (bool, string, error) {
+	opts := gl.WithContext(ctx)
+	p, _, err := c.client.Projects.GetProject(t.ProjectID, nil, opts)
+	if err != nil || p == nil || p.ID != t.ProjectID || p.PathWithNamespace != t.Project {
+		return false, "", errors.New("project mismatch")
+	}
+	b, _, err := c.client.Branches.GetBranch(t.ProjectID, t.Ref, opts)
+	if err != nil || b == nil || b.Name != t.Ref {
+		return false, "", errors.New("branch mismatch")
+	}
+	// Exactly latest pipeline for the selected branch/source. No next-page traversal or discovery.
+	ref, source, order, sort, scope := t.Ref, t.Source, "id", "desc", "branches"
+	ps, _, err := c.client.Pipelines.ListProjectPipelines(t.ProjectID, &gl.ListProjectPipelinesOptions{ListOptions: gl.ListOptions{Page: 1, PerPage: 1}, Ref: &ref, Source: &source, Scope: &scope, OrderBy: &order, Sort: &sort}, opts)
+	if err != nil || len(ps) > 1 {
+		return false, "", errors.New("pipeline list invalid")
+	}
+	if len(ps) == 0 {
+		return false, "other", nil
+	}
+	q := ps[0]
+	if q == nil || q.ID <= 0 || q.ProjectID != t.ProjectID || q.Ref != t.Ref || q.Source != t.Source {
+		return false, "", errors.New("pipeline list mismatch")
+	}
+	d, _, err := c.client.Pipelines.GetPipeline(t.ProjectID, q.ID, opts)
+	if err != nil || d == nil || d.ID != q.ID || d.ProjectID != t.ProjectID || d.Ref != t.Ref || string(d.Source) != t.Source || d.Status == "" || d.Tag {
+		return false, "", errors.New("pipeline detail mismatch")
+	}
+	status := "other"
+	if d.Status == "failed" || d.Status == "success" {
+		status = d.Status
+	}
+	return true, status, nil
+}
+
+// Run has one bounded sequential polling loop, no persistent state or overlapping scheduled cycles.
+func (c *Collector) Run(ctx context.Context) {
+	for {
+		for i := range c.slots {
+			if ctx.Err() != nil {
+				return
+			}
+			_ = c.Poll(ctx, i)
+		}
+		timer := time.NewTimer(time.Duration(c.cfg.IntervalSeconds) * time.Second)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return
+		case <-timer.C:
+		}
+	}
+}
+
+// Enforce origin and response bounds below the upstream API client, including Link URLs.
+type originTransport struct {
+	base    http.RoundTripper
+	origin  string
+	limiter *rate.Limiter
+}
+
+func (t *originTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	if r.Method != http.MethodGet || r.URL.Scheme != "https" || r.URL.Host != t.origin || r.URL.User != nil || !strings.HasPrefix(r.URL.Path, "/api/v4/") {
+		return nil, errors.New("snapshot request boundary")
+	}
+	if err := t.limiter.Wait(r.Context()); err != nil {
+		return nil, errors.New("snapshot rate deadline")
+	}
+	resp, err := t.base.RoundTrip(r)
+	if err != nil {
+		return nil, err
+	}
+	resp.Body = http.MaxBytesReader(nil, resp.Body, 1<<20)
+	return resp, nil
+}
+
+// Separate inputs intentionally model suspend/NTP where monotonic and wall clocks diverge.
+func freshAges(monotonic, wall, ceiling float64) bool {
+	return monotonic >= 0 && monotonic <= ceiling && wall >= 0 && wall <= ceiling
+}
diff --git a/pkg/snapshot/snapshot_test.go b/pkg/snapshot/snapshot_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..1c7bd74b8bc5b01971e3f02898a603d50070c805
--- /dev/null
+++ b/pkg/snapshot/snapshot_test.go
@@ -0,0 +1,361 @@
+package snapshot
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/prometheus/client_golang/prometheus"
+)
+
+func settings() Config {
+	return Config{Enabled: true, IntervalSeconds: 15, TimeoutSeconds: 1, Targets: []Target{{ProjectID: 7, Project: "tenants/portal/proof", Ref: "main", Source: "push"}}}
+}
+
+type fake struct {
+	mu                           sync.Mutex
+	status, fail, body, redirect string
+	empty                        bool
+	entered, release             chan struct{}
+	calls                        atomic.Int32
+}
+
+func (f *fake) handler(w http.ResponseWriter, r *http.Request) {
+	f.calls.Add(1)
+	if r.Header.Get("PRIVATE-TOKEN") != "OFFLINE.fake" {
+		http.Error(w, "auth", 401)
+		return
+	}
+	f.mu.Lock()
+	status, fail, body, redirect, empty, entered, release := f.status, f.fail, f.body, f.redirect, f.empty, f.entered, f.release
+	f.mu.Unlock()
+	if strings.HasSuffix(r.URL.Path, "/pipelines/11") && entered != nil {
+		select {
+		case entered <- struct{}{}:
+		default:
+		}
+		select {
+		case <-release:
+		case <-r.Context().Done():
+			return
+		}
+	}
+	if strings.Contains(r.URL.Path, fail) && fail != "" {
+		if redirect != "" {
+			http.Redirect(w, r, redirect, 302)
+			return
+		}
+		if body != "" {
+			fmt.Fprint(w, body)
+			return
+		}
+		http.Error(w, "fake failure", 403)
+		return
+	}
+	switch r.URL.Path {
+	case "/api/v4/projects/7":
+		fmt.Fprint(w, `{"id":7,"path_with_namespace":"tenants/portal/proof"}`)
+	case "/api/v4/projects/7/repository/branches/main":
+		fmt.Fprint(w, `{"name":"main"}`)
+	case "/api/v4/projects/7/pipelines":
+		if r.URL.Query().Get("ref") != "main" || r.URL.Query().Get("source") != "push" || r.URL.Query().Get("per_page") != "1" || r.URL.Query().Get("scope") != "branches" {
+			http.Error(w, "query", 400)
+			return
+		}
+		if empty {
+			fmt.Fprint(w, `[]`)
+		} else {
+			fmt.Fprint(w, `[{"id":11,"project_id":7,"ref":"main","source":"push"}]`)
+		}
+	case "/api/v4/projects/7/pipelines/11":
+		fmt.Fprintf(w, `{"id":11,"project_id":7,"ref":"main","source":"push","status":%q}`, status)
+	default:
+		http.Error(w, "unexpected", 404)
+	}
+}
+func setup(t *testing.T) (*Collector, *fake) {
+	t.Helper()
+	f := &fake{status: "failed"}
+	srv := httptest.NewTLSServer(http.HandlerFunc(f.handler))
+	t.Cleanup(srv.Close)
+	c, err := New(settings(), srv.URL, "OFFLINE.fake", srv.Client().Transport.(*http.Transport), 10, 10)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return c, f
+}
+func values(t *testing.T, c *Collector) map[string]float64 {
+	t.Helper()
+	r := prometheus.NewRegistry()
+	r.MustRegister(c)
+	ms, err := r.Gather()
+	if err != nil {
+		t.Fatal(err)
+	}
+	out := map[string]float64{}
+	for _, m := range ms {
+		for _, v := range m.Metric {
+			k := m.GetName()
+			for _, l := range v.Label {
+				if l.GetName() == "status" {
+					k += "/" + l.GetValue()
+				}
+			}
+			out[k] = v.GetGauge().GetValue()
+		}
+	}
+	return out
+}
+func TestLifecycle(t *testing.T) {
+	c, f := setup(t)
+	ctx := context.Background()
+	if values(t, c)["gcpe_pipeline_snapshot_valid"] != 0 {
+		t.Fatal("cold fresh")
+	}
+	for _, status := range []string{"failed", "running", "canceled", "success"} {
+		f.mu.Lock()
+		f.status = status
+		f.mu.Unlock()
+		if err := c.Poll(ctx, 0); err != nil {
+			t.Fatal(err)
+		}
+		v := values(t, c)
+		key := status
+		if status != "failed" && status != "success" {
+			key = "other"
+		}
+		if v["gcpe_pipeline_snapshot_valid"] != 1 || v["gcpe_pipeline_snapshot_status/"+key] != 1 {
+			t.Fatal(v)
+		}
+	}
+	f.mu.Lock()
+	f.empty = true
+	f.mu.Unlock()
+	if err := c.Poll(ctx, 0); err != nil {
+		t.Fatal(err)
+	}
+	v := values(t, c)
+	if v["gcpe_pipeline_snapshot_present"] != 0 || v["gcpe_pipeline_snapshot_status/success"] != 0 {
+		t.Fatal("empty recovery", v)
+	}
+	restarted, _ := setup(t)
+	if values(t, restarted)["gcpe_pipeline_snapshot_valid"] != 0 {
+		t.Fatal("restart fresh")
+	}
+}
+func TestFaultsRetainOnlyHistoricalState(t *testing.T) {
+	for _, tc := range []struct{ name, path, body string }{
+		{"list403", "/pipelines", ""}, {"detail403", "/pipelines/11", ""}, {"malformed", "/pipelines/11", "{"}, {"wrongproject", "/projects/7", `{"id":8,"path_with_namespace":"tenants/portal/proof"}`}, {"wrongref", "/pipelines/11", `{"id":11,"project_id":7,"ref":"other","source":"push","status":"success"}`}, {"samename-tag", "/pipelines/11", `{"id":11,"project_id":7,"ref":"main","source":"push","status":"success","tag":true}`},
+		{"wrongsource", "/pipelines/11", `{"id":11,"project_id":7,"ref":"main","source":"web","status":"success"}`}, {"missingstatus", "/pipelines/11", `{"id":11,"project_id":7,"ref":"main","source":"push"}`}, {"oversize", "/pipelines/11", strings.Repeat(" ", 1<<20) + `{}`}, {"duplicate", "/pipelines", `[{"id":11},{"id":11}]`},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			c, f := setup(t)
+			if err := c.Poll(context.Background(), 0); err != nil {
+				t.Fatal(err)
+			}
+			before := values(t, c)
+			f.mu.Lock()
+			f.fail = tc.path
+			f.body = tc.body
+			f.mu.Unlock()
+			if err := c.Poll(context.Background(), 0); err == nil {
+				t.Fatal("accepted")
+			}
+			after := values(t, c)
+			if after["gcpe_pipeline_snapshot_valid"] != 0 || after["gcpe_pipeline_snapshot_last_success_timestamp_seconds"] != before["gcpe_pipeline_snapshot_last_success_timestamp_seconds"] || after["gcpe_pipeline_snapshot_status/failed"] != 1 {
+				t.Fatal(after)
+			}
+		})
+	}
+}
+func TestConcurrentScrapeAndTimeout(t *testing.T) {
+	c, f := setup(t)
+	if err := c.Poll(context.Background(), 0); err != nil {
+		t.Fatal(err)
+	}
+	f.mu.Lock()
+	f.status = "success"
+	f.entered = make(chan struct{}, 1)
+	f.release = make(chan struct{})
+	entered, release := f.entered, f.release
+	f.mu.Unlock()
+	done := make(chan error, 1)
+	go func() { done <- c.Poll(context.Background(), 0) }()
+	<-entered
+	for i := 0; i < 50; i++ {
+		v := values(t, c)
+		if v["gcpe_pipeline_snapshot_valid"] != 0 || v["gcpe_pipeline_snapshot_status/success"] != 0 {
+			t.Fatal(v)
+		}
+	}
+	if err := <-done; err == nil {
+		t.Fatal("timeout accepted")
+	}
+	close(release)
+	if values(t, c)["gcpe_pipeline_snapshot_valid"] != 0 {
+		t.Fatal("timeout fresh")
+	}
+}
+func TestSerializedPolls(t *testing.T) {
+	c, f := setup(t)
+	f.entered = make(chan struct{}, 2)
+	f.release = make(chan struct{})
+	done := make(chan error, 2)
+	go func() { done <- c.Poll(context.Background(), 0) }()
+	<-f.entered
+	go func() { done <- c.Poll(context.Background(), 0) }()
+	time.Sleep(20 * time.Millisecond)
+	if f.calls.Load() != 4 {
+		t.Fatal("overlap", f.calls.Load())
+	}
+	close(f.release)
+	for i := 0; i < 2; i++ {
+		if err := <-done; err != nil {
+			t.Fatal(err)
+		}
+	}
+	if values(t, c)["gcpe_pipeline_snapshot_generation"] != 2 {
+		t.Fatal("generation")
+	}
+}
+func TestRedirectTLSAndCancellation(t *testing.T) {
+	c, f := setup(t)
+	var hits atomic.Int32
+	other := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { hits.Add(1) }))
+	defer other.Close()
+	f.fail = "/projects/7"
+	f.redirect = other.URL
+	if c.Poll(context.Background(), 0) == nil || hits.Load() != 0 {
+		t.Fatal("redirect followed")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if c.Poll(ctx, 0) == nil {
+		t.Fatal("cancel")
+	}
+	_, err := New(settings(), other.URL, "OFFLINE.fake", nil, 10, 10)
+	if err != nil {
+		t.Fatal(err)
+	}
+	untrusted, _ := New(settings(), other.URL, "OFFLINE.fake", nil, 10, 10)
+	if untrusted.Poll(context.Background(), 0) == nil {
+		t.Fatal("untrusted TLS")
+	}
+	if _, err := New(settings(), "http://example.test", "fake", nil, 10, 10); err == nil {
+		t.Fatal("http")
+	}
+}
+func TestClockAndStaleness(t *testing.T) {
+	c, _ := setup(t)
+	now := time.Now()
+	c.now = func() time.Time { return now }
+	if err := c.Poll(context.Background(), 0); err != nil {
+		t.Fatal(err)
+	}
+	for _, delta := range []time.Duration{-time.Second, 46 * time.Second} {
+		now = now.Add(delta)
+		if values(t, c)["gcpe_pipeline_snapshot_valid"] != 0 {
+			t.Fatal("clock fresh")
+		}
+		now = now.Add(-delta)
+	}
+}
+func TestBounds(t *testing.T) {
+	for _, mut := range []func(*Config){func(c *Config) { c.Targets = append(c.Targets, c.Targets[0]) }, func(c *Config) { c.Targets[0].Source = "web" }, func(c *Config) { c.Targets[0].Ref = "../foreign" }, func(c *Config) { c.IntervalSeconds = 1 }, func(c *Config) { c.Targets = make([]Target, 17) }} {
+		c := settings()
+		mut(&c)
+		if c.Validate() == nil {
+			t.Fatal("bad config")
+		}
+	}
+}
+
+func TestCancellationDuringDetail(t *testing.T) {
+	c, f := setup(t)
+	f.entered = make(chan struct{}, 1)
+	f.release = make(chan struct{})
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- c.Poll(ctx, 0) }()
+	<-f.entered
+	cancel()
+	if <-done == nil {
+		t.Fatal("cancel accepted")
+	}
+	if values(t, c)["gcpe_pipeline_snapshot_last_success_timestamp_seconds"] != 0 {
+		t.Fatal("partial stamp")
+	}
+}
+func TestClockRollbackDuringObservation(t *testing.T) {
+	c, f := setup(t)
+	var clockMu sync.Mutex
+	now := time.Now()
+	c.now = func() time.Time { clockMu.Lock(); defer clockMu.Unlock(); return now }
+	f.entered = make(chan struct{}, 1)
+	f.release = make(chan struct{})
+	done := make(chan error, 1)
+	go func() { done <- c.Poll(context.Background(), 0) }()
+	<-f.entered
+	clockMu.Lock()
+	now = now.Add(-time.Minute)
+	clockMu.Unlock()
+	close(f.release)
+	if <-done == nil {
+		t.Fatal("rollback accepted")
+	}
+}
+func TestEndpointErrorsAndForeignLabels(t *testing.T) {
+	for _, code := range []int{401, 404, 429, 500} {
+		t.Run(fmt.Sprint(code), func(t *testing.T) {
+			srv := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { http.Error(w, "untrusted token=not-a-real-secret", code) }))
+			defer srv.Close()
+			c, err := New(settings(), srv.URL, "OFFLINE.fake", srv.Client().Transport.(*http.Transport), 10, 10)
+			if err != nil {
+				t.Fatal(err)
+			}
+			err = c.Poll(context.Background(), 0)
+			if err == nil || strings.Contains(err.Error(), "untrusted") {
+				t.Fatal("error leak")
+			}
+			v := values(t, c)
+			if len(v) != 8 || v["gcpe_pipeline_snapshot_valid"] != 0 {
+				t.Fatal(v)
+			}
+		})
+	}
+}
+
+func TestIndependentClockAges(t *testing.T) {
+	for _, tc := range []struct {
+		mono, wall float64
+		want       bool
+	}{
+		{1, 1, true}, {1, 46, false}, {46, 1, false}, {1, -1, false}, {-1, 1, false}, {45, 45, true},
+	} {
+		if freshAges(tc.mono, tc.wall, 45) != tc.want {
+			t.Fatalf("mono=%v wall=%v", tc.mono, tc.wall)
+		}
+	}
+}
+
+func TestRateLimitHonorsWholePollDeadline(t *testing.T) {
+	f := &fake{status: "success"}
+	srv := httptest.NewTLSServer(http.HandlerFunc(f.handler))
+	defer srv.Close()
+	c, err := New(settings(), srv.URL, "OFFLINE.fake", srv.Client().Transport.(*http.Transport), 1, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = c.Poll(context.Background(), 0); err == nil {
+		t.Fatal("rate budget bypassed")
+	}
+	if f.calls.Load() != 1 || values(t, c)["gcpe_pipeline_snapshot_valid"] != 0 {
+		t.Fatal("unexpected rate result")
+	}
+}
