--- /dev/null
+++ b/pkg/config/snapshot.go
@@ -0,0 +1,39 @@
+package config
+
+import "errors"
+
+// ValidateSnapshot leaves legacy behavior untouched unless explicitly enabled.
+func (c Config) ValidateSnapshot() error {
+	if !c.PipelineSnapshot.Enabled {
+		return nil
+	}
+	if err := c.PipelineSnapshot.Validate(); err != nil {
+		return err
+	}
+	if c.Gitlab.MaximumRequestsPerSecond < 1 || c.Gitlab.MaximumRequestsPerSecond > 10 || c.Gitlab.BurstableRequestsPerSecond < 1 || c.Gitlab.BurstableRequestsPerSecond > 10 {
+		return errors.New("snapshot rate bounds invalid")
+	}
+	if c.Redis.URL != "" || len(c.Wildcards) > 0 || c.Server.Webhook.Enabled || c.Server.EnablePprof || !c.Server.Metrics.Enabled || !c.Gitlab.EnableTLSVerify || c.OpenTelemetry.GRPCEndpoint != "" {
+		return errors.New("snapshot unsupported runtime option")
+	}
+	expected := map[string]bool{}
+	for _, t := range c.PipelineSnapshot.Targets {
+		expected[t.Project] = true
+	}
+	if len(c.Projects) != len(expected) {
+		return errors.New("snapshot projects must match targets")
+	}
+	check := func(p ProjectParameters) bool {
+		return p.Pull.Environments.Enabled || p.Pull.Refs.Tags.Enabled || p.Pull.Refs.MergeRequests.Enabled || p.Pull.Pipeline.Jobs.Enabled || p.Pull.Pipeline.Variables.Enabled || p.Pull.Pipeline.TestReports.Enabled
+	}
+	if check(c.ProjectDefaults) {
+		return errors.New("snapshot optional collection unsupported")
+	}
+	for _, p := range c.Projects {
+		if !expected[p.Name] || check(p.ProjectParameters) {
+			return errors.New("snapshot project options unsupported")
+		}
+		delete(expected, p.Name)
+	}
+	return nil
+}
