@@ -0,0 +1,65 @@
+package config
+
+import (
+	"github.com/mvisonneau/gitlab-ci-pipelines-exporter/pkg/snapshot"
+	"testing"
+)
+
+func snapshotConfig() Config {
+	return Config{Gitlab: Gitlab{EnableTLSVerify: true, MaximumRequestsPerSecond: 1, BurstableRequestsPerSecond: 2}, Server: Server{Metrics: ServerMetrics{Enabled: true}}, Projects: []Project{{Name: "tenants/portal/proof"}}, PipelineSnapshot: snapshot.Config{Enabled: true, IntervalSeconds: 30, TimeoutSeconds: 10, Targets: []snapshot.Target{{ProjectID: 7, Project: "tenants/portal/proof", Ref: "main", Source: "push"}}}}
+}
+func TestSnapshotUnsupportedModes(t *testing.T) {
+	for _, mut := range []func(*Config){
+		func(c *Config) { c.Redis.URL = "redis://invalid" }, func(c *Config) { c.Server.Webhook.Enabled = true }, func(c *Config) { c.Server.EnablePprof = true }, func(c *Config) { c.Gitlab.EnableTLSVerify = false }, func(c *Config) { c.OpenTelemetry.GRPCEndpoint = "invalid" }, func(c *Config) { c.Wildcards = []Wildcard{{}} }, func(c *Config) { c.ProjectDefaults.Pull.Pipeline.Jobs.Enabled = true }, func(c *Config) { c.Projects[0].Pull.Pipeline.Variables.Enabled = true }, func(c *Config) { c.Projects[0].Pull.Refs.Tags.Enabled = true }, func(c *Config) { c.Projects[0].Pull.Environments.Enabled = true }, func(c *Config) { c.Projects[0].Name = "foreign" },
+	} {
+		c := snapshotConfig()
+		if c.ValidateSnapshot() != nil {
+			t.Fatal("good rejected")
+		}
+		mut(&c)
+		if c.ValidateSnapshot() == nil {
+			t.Fatal("unsupported accepted")
+		}
+		c.PipelineSnapshot.Enabled = false
+		if c.ValidateSnapshot() != nil {
+			t.Fatal("legacy changed")
+		}
+	}
+}
+
+func TestSnapshotYAMLHydration(t *testing.T) {
+	raw := []byte(`pipeline_snapshot:
+  enabled: true
+  interval_seconds: 30
+  timeout_seconds: 10
+  targets:
+    - project_id: 7
+      project: tenants/portal/proof
+      ref: main
+      source: push
+project_defaults:
+  pull:
+    refs:
+      tags: {enabled: false}
+projects:
+  - name: tenants/portal/proof
+`)
+	c, err := Parse(FormatYAML, raw)
+	if err != nil || !c.PipelineSnapshot.Enabled || len(c.PipelineSnapshot.Targets) != 1 {
+		t.Fatalf("snapshot dropped: %v", err)
+	}
+	if err = c.ValidateSnapshot(); err != nil {
+		t.Fatal(err)
+	}
+	c.PipelineSnapshot.Targets[0].Source = "web"
+	if c.ValidateSnapshot() == nil {
+		t.Fatal("bad parsed config")
+	}
+}
+func TestSnapshotUnknownYAMLFieldDenied(t *testing.T) {
+	for _, s := range []string{"pipeline_snapshot: {enabld: true}", "pipeline_snapshot: {targets: [{project: a/b, sourc: push}]}"} {
+		if _, e := Parse(FormatYAML, []byte(s)); e == nil {
+			t.Fatal("unknown field accepted")
+		}
+	}
+}
