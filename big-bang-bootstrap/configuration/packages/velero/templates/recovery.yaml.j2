{% if velero_recovery_action == 'restore' %}
apiVersion: velero.io/v1
kind: Restore
metadata:
  name: {{ velero_recovery_name }}
  namespace: velero
  labels: {perkforge.io/owner: velero-platform-v1}
spec:
  backupName: {{ velero_backup_name }}
  includedNamespaces: [{{ velero_source_namespace }}]
  includedResources: {{ velero_restore_resource_types | to_json }}
  includeClusterResources: false
  namespaceMapping: { {{ velero_source_namespace }}: {{ velero_target_namespace }} }
  existingResourcePolicy: none
  restorePVs: true
  itemOperationTimeout: 30m0s
  hooks: {resources: {{ velero_restore_hooks | to_json }} }
{% else %}
apiVersion: velero.io/v1
kind: {{ 'Schedule' if velero_recovery_action == 'paused-schedule' else 'Backup' }}
metadata:
  name: {{ velero_recovery_name }}
  namespace: velero
  labels: {perkforge.io/owner: velero-platform-v1}
  annotations:
    velero.io/csi-volumesnapshot-class_driver.longhorn.io: velero-longhorn-snap
    recovery.perkforge.io/source-pvcs: {{ velero_source_catalog | to_json | to_json }}
{% for key,value in velero_recovery_versions.items() %}
    recovery.perkforge.io/{{ key | replace('_','-') }}: {{ value | to_json }}
{% endfor %}
spec:
{% if velero_recovery_action == 'paused-schedule' %}
  paused: true
  useOwnerReferencesInBackup: false
  skipImmediately: true
  schedule: {{ velero_schedule_cron | to_json }}
  template:
{% endif %}
{{ velero_backup_spec | to_nice_yaml(indent=2) | indent(4 if velero_recovery_action == 'paused-schedule' else 2,true) }}
{% endif %}
