{
  "uid": "pf-app-{{ app.id }}",
  "title": {{ (app.title ~ " — Resources and network") | to_json }},
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "perkforge",
    "platform-app-resources"
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Scope and unavailable data",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Platform-only namespace application inventory. Includes supporting workloads/jobs in these exact namespaces; not cross-namespace HTTP attribution. No data means unavailable, never zero or healthy. Missing limits may make totals partial. Pod network uses one sandbox interface series, excludes hostNetwork and loopback; it is bytes, not requests/users. HTTP rate/errors/latency unavailable: no verified app-attributed exporter. PVC panels show claims in the application namespaces, not per-pod additive copies. Review sample age and upstream scrape health. This dashboard does not grant access or enforce tenant isolation."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU cores",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "{{ app_dashboards_datasource_uid }}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "noValue": "Unavailable",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by(namespace,pod,container) (rate(container_cpu_usage_seconds_total{namespace=~\"{{ app.namespaces | join('|') }}\",job=\"kubelet\",metrics_path=\"/metrics/cadvisor\",container!=\"\",container!=\"POD\"}[5m])))",
          "range": true,
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus",
            "uid": "{{ app_dashboards_datasource_uid }}"
          }
        }
      ]
    },
