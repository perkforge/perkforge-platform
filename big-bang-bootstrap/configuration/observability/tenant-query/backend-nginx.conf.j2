# Inactive integration proof, not selected by the deployment renderer.
# Co-locate only with Prometheus, never Grafana or tenant workloads.
worker_processes 1;
pid {{ runtime_dir }}/backend-nginx.pid;
error_log {{ runtime_dir }}/backend-error.log warn;
events { worker_connections 128; }
http {
    access_log off;
    client_body_temp_path {{ runtime_dir }}/backend-body;
    proxy_temp_path {{ runtime_dir }}/backend-proxy;
    fastcgi_temp_path {{ runtime_dir }}/backend-fastcgi;
    scgi_temp_path {{ runtime_dir }}/backend-scgi;
    uwsgi_temp_path {{ runtime_dir }}/backend-uwsgi;
    server {
        listen {{ backend_listen_address }} ssl;
        ssl_certificate {{ certificate_path }};
        ssl_certificate_key {{ private_key_path }};
        ssl_client_certificate {{ client_ca_path }};
        ssl_verify_client on;
        ssl_protocols TLSv1.2 TLSv1.3;
        client_max_body_size 64k;
        # Query reads and authenticated self-scrape only. Never expose lifecycle.
{% for endpoint in ['/api/v1/query', '/api/v1/query_range', '/metrics'] %}
        location = {{ endpoint }} {
            limit_except GET POST { deny all; }
            proxy_pass_request_headers off;
            proxy_set_header Content-Type $content_type;
            proxy_connect_timeout 3s;
            proxy_read_timeout 30s;
            proxy_pass http://127.0.0.1:{{ prometheus_loopback_port }};
        }
{% endfor %}
        location / { return 404; }
    }
}
