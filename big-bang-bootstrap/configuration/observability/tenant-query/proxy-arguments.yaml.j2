# One gateway-owned process per authenticated context; never a Service/public port.
# Namespace values come from platform-owned context, not request headers/parameters.
{% for context in query_contexts %}
- context: {{ context.id }}
  arguments:
    - -insecure-listen-address=127.0.0.1:{{ context.proxy_port }}
    - -upstream={{ metrics_upstream }}
{% if metrics_upstream.startswith('https://') %}
    - -upstream-ca-cert={{ upstream_ca_path }}
    - -upstream-client-cert={{ upstream_client_cert_path }}
    - -upstream-client-key={{ upstream_client_key_path }}
{% endif %}
    - -label=namespace
    - -error-on-replace
{% for namespace in context.namespaces %}
    - -label-value={{ namespace }}
{% endfor %}
{% endfor %}
