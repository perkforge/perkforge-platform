# Unselected Flux-compatible candidate. Secrets supplied separately; never generated here.
apiVersion: v1
kind: ServiceAccount
metadata: {name: tenant-query-gateway, namespace: {{ gateway_namespace | to_json }}}
automountServiceAccountToken: false
---
apiVersion: v1
kind: ConfigMap
metadata: {name: tenant-query-gateway, namespace: {{ gateway_namespace | to_json }}}
data:
  nginx.conf: |
{{ lookup('template', playbook_dir + '/nginx.conf.j2') | indent(4, true) }}
---
apiVersion: v1
kind: Service
metadata: {name: tenant-query-gateway, namespace: {{ gateway_namespace | to_json }}}
spec:
  type: ClusterIP
  selector: {app.kubernetes.io/name: tenant-query-gateway}
  ports: [{name: https, port: 8443, targetPort: https}]
---
apiVersion: apps/v1
kind: Deployment
metadata: {name: tenant-query-gateway, namespace: {{ gateway_namespace | to_json }}}
spec:
  replicas: 1
  selector: {matchLabels: {app.kubernetes.io/name: tenant-query-gateway}}
  template:
    metadata: {labels: {app.kubernetes.io/name: tenant-query-gateway}}
    spec:
      serviceAccountName: tenant-query-gateway
      automountServiceAccountToken: false
      nodeSelector: {kubernetes.io/arch: amd64}
      securityContext: {runAsUser: 1000, runAsGroup: 1000, runAsNonRoot: true, fsGroup: 1000, seccompProfile: {type: RuntimeDefault}}
      containers:
      - name: tls-auth
        image: docker.io/library/nginx:1.31.6-alpine@sha256:0530961ff0592b58c10f767535cc0abdfccf9e389ff7cc90f87320c1bc7e8506
        command: [/usr/sbin/nginx]
        args: [-c, /etc/gateway/config/nginx.conf, -g, 'daemon off;']
        securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
        resources: {requests: {cpu: 20m, memory: 64Mi}, limits: {cpu: 500m, memory: 128Mi}}
        ports: [{name: https, containerPort: 8443}]
        readinessProbe: {tcpSocket: {port: https}, periodSeconds: 5}
        volumeMounts:
        - {name: config, mountPath: /etc/gateway/config, readOnly: true}
        - {name: runtime, mountPath: /tmp/gateway}
        - {name: tls, mountPath: /etc/gateway/tls, readOnly: true}
        - {name: upstream, mountPath: /etc/gateway/upstream, readOnly: true}
{% for context in query_contexts %}
        - {name: 'auth-{{ context.id }}', mountPath: '/etc/gateway/auth/{{ context.id }}', readOnly: true}
{% endfor %}
        - {name: auth-platform, mountPath: /etc/gateway/auth/platform, readOnly: true}
{% for context in query_contexts %}
      - name: scope-{{ context.id }}
        image: quay.io/prometheuscommunity/prom-label-proxy:v0.16.2@sha256:e04529e2d4bddf7b97732befab926f84ba944631bfd8b8929534a58f086a9d2e
        command: [/bin/prom-label-proxy]
        args:
        - -insecure-listen-address=127.0.0.1:{{ context.proxy_port }}
        - -internal-listen-address=0.0.0.0:{{ context.health_port }}
        - -upstream={{ metrics_upstream }}
        - -upstream-ca-cert={{ upstream_ca_path }}
        - -upstream-client-cert={{ upstream_client_cert_path }}
        - -upstream-client-key={{ upstream_client_key_path }}
        - -label=namespace
        - -error-on-replace
{% for namespace in context.namespaces %}
        - -label-value={{ namespace }}
{% endfor %}
        securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
        resources: {requests: {cpu: 20m, memory: 64Mi}, limits: {cpu: 500m, memory: 256Mi}}
        readinessProbe: {httpGet: {path: /metrics, port: {{ context.health_port }}}, periodSeconds: 5}
        volumeMounts:
        - {name: upstream, mountPath: /etc/gateway/upstream, readOnly: true}
{% endfor %}
      volumes:
      - {name: config, configMap: {name: tenant-query-gateway}}
      - {name: runtime, emptyDir: {medium: Memory, sizeLimit: 32Mi}}
      - {name: tls, secret: {secretName: {{ gateway_tls_secret | to_json }}, defaultMode: 288}}
      - {name: upstream, secret: {secretName: {{ upstream_client_secret | to_json }}, defaultMode: 288}}
{% for context in query_contexts %}
      - {name: 'auth-{{ context.id }}', secret: {secretName: {{ context.auth_secret_name | to_json }}, defaultMode: 288}}
{% endfor %}
      - {name: auth-platform, secret: {secretName: {{ platform_query.auth_secret_name | to_json }}, defaultMode: 288}}
---
# Authentication still binds scope; source pod identity alone never grants PE access.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: tenant-query-gateway, namespace: {{ gateway_namespace | to_json }}}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: tenant-query-gateway}}
  policyTypes: [Ingress, Egress]
  ingress:
  - from:
    - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: monitoring}}
      podSelector: {matchLabels: {app.kubernetes.io/name: grafana, app.kubernetes.io/instance: monitoring-grafana}}
    ports: [{protocol: TCP, port: 8443}]
  egress:
  - to:
    - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: monitoring}}
      podSelector: {matchLabels: {operator.prometheus.io/name: monitoring-monitoring-kube-prometheus}}
    ports: [{protocol: TCP, port: {{ 9443 if (backend_transport | default('direct-mtls')) == 'loopback-sidecar' else 9090 }}}]
  - to:
    - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: kube-system}}
      podSelector: {matchLabels: {k8s-app: kube-dns}}
    ports: [{protocol: UDP, port: 53}, {protocol: TCP, port: 53}]
---
# Adds only gateway-to-Prometheus access. Existing policies are additive, not replaced.
# This alone does NOT remove Grafana's current raw-backend bypass.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: prometheus-from-tenant-query-gateway, namespace: monitoring}
spec:
  podSelector: {matchLabels: {operator.prometheus.io/name: monitoring-monitoring-kube-prometheus}}
  policyTypes: [Ingress]
  ingress:
  - from:
    - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: {{ gateway_namespace | to_json }}}}
      podSelector: {matchLabels: {app.kubernetes.io/name: tenant-query-gateway}}
    ports: [{protocol: TCP, port: {{ 9443 if (backend_transport | default('direct-mtls')) == 'loopback-sidecar' else 9090 }}}]
