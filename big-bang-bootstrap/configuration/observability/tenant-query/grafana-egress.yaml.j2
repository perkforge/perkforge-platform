# Target-dependent service/endpoint CIDRs are inputs, never baked into the image.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: grafana-query-egress, namespace: monitoring}
spec:
  podSelector:
    matchLabels: {app.kubernetes.io/name: grafana, app.kubernetes.io/instance: monitoring-grafana}
  policyTypes: [Egress]
  egress:
  - to:
    - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: {{ gateway_namespace }}}}
      podSelector: {matchLabels: {app.kubernetes.io/name: tenant-query-gateway}}
    ports: [{protocol: TCP, port: 8443}]
  - to:
    - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: kube-system}}
      podSelector: {matchLabels: {k8s-app: kube-dns}}
    ports: [{protocol: UDP, port: 53}, {protocol: TCP, port: 53}]
{% for endpoint in grafana_required_endpoints %}
  - to: [{ipBlock: {cidr: {{ endpoint.cidr | to_json }}}}]
    ports: [{protocol: TCP, port: {{ endpoint.port }}}]
{% endfor %}
{% if grafana_loki_enabled | default(false) | bool %}
  - to:
    - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: logging}}
      podSelector:
        matchLabels: {app.kubernetes.io/component: gateway, app.kubernetes.io/instance: logging-loki}
    ports: [{protocol: TCP, port: 8080}]
{% endif %}
{% if grafana_rke2_ingress_backend_enabled | default(false) | bool %}
  # Explicit RKE2 hostPort/Service443 translated backend, not broad node egress.
  - to:
    - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: kube-system}}
      podSelector:
        matchLabels:
          app.kubernetes.io/name: rke2-traefik
          app.kubernetes.io/instance: rke2-traefik-kube-system
    ports: [{protocol: TCP, port: 8443}]
{% endif %}
