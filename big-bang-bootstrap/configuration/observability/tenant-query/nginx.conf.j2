# Inactive standalone gateway candidate. Caller supplies protected absolute paths.
# Never co-locate this gateway with Grafana: proxy listeners are loopback-only.
worker_processes 1;
pid {{ runtime_dir }}/nginx.pid;
error_log {{ runtime_dir }}/error.log warn;
events { worker_connections 128; }
http {
    access_log off;
    client_body_temp_path {{ runtime_dir }}/client-body;
    proxy_temp_path {{ runtime_dir }}/proxy;
    fastcgi_temp_path {{ runtime_dir }}/fastcgi;
    scgi_temp_path {{ runtime_dir }}/scgi;
    uwsgi_temp_path {{ runtime_dir }}/uwsgi;
    server {
        listen {{ listen_address }} ssl;
        server_name {{ server_name }};
        ssl_certificate {{ certificate_path }};
        ssl_certificate_key {{ private_key_path }};
        ssl_protocols TLSv1.2 TLSv1.3;
        client_max_body_size 64k;
        # Only these read query endpoints are reviewed. No generic proxy location.
{% for context in query_contexts %}
{% for endpoint in ['query', 'query_range'] %}
        location = /{{ context.id }}/api/v1/{{ endpoint }} {
            auth_basic "tenant metrics";
            auth_basic_user_file {{ context.htpasswd_path }};
            limit_except GET POST { deny all; }
            proxy_pass_request_headers off;
            proxy_set_header Content-Type $content_type;
            proxy_set_header Host localhost;
            proxy_connect_timeout 3s;
            proxy_read_timeout 30s;
            proxy_pass http://127.0.0.1:{{ context.proxy_port }}/api/v1/{{ endpoint }};
        }
{% endfor %}
{% endfor %}
        location / { return 404; }
    }
}
