apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
- ../{{ 'perkforge-flux-placement' if flux_kustomize_node_selector | default({}) | length > 0 else 'flux' }}
patches:
- target: {group: apps, version: v1, kind: Deployment, name: helm-controller, namespace: flux-system}
  patch: |-
    apiVersion: apps/v1
    kind: Deployment
    metadata: {name: helm-controller, namespace: flux-system}
    spec:
      strategy:
        type: Recreate
        rollingUpdate: null
      template:
        spec:
          nodeSelector: {{ flux_helm_node_selector | to_json }}
          containers:
          - name: manager
            resources:
              requests:
                cpu: {{ (flux_helm_cpu_request_millicores | string + 'm') | to_json }}
