# Source: bigbang/templates/headlamp/values.yaml
apiVersion: v1
kind: Secret
metadata:
  name: bigbang-headlamp-values
  namespace: bigbang
type: generic
stringData:
  common: |
    istio:
      ambient:
        enabled: false
      authorizationPolicies:
        enabled: false
        generateFromNetpol: false
      enabled: false
      injection: enabled
      sidecar:
        enabled: false
    networkPolicies:
      egress:
        definitions:
          database-subnets:
            ports:
            - port: 5432
              protocol: TCP
            to:
            - ipBlock:
                cidr: 192.168.0.0/16
            - ipBlock:
                cidr: 172.16.0.0/12
            - ipBlock:
                cidr: 10.0.0.0/8
          kafka-subnets:
            ports:
            - port: 9092
              protocol: TCP
            - port: 9093
              protocol: TCP
            to:
            - ipBlock:
                cidr: 0.0.0.0/0
          kubeAPI:
            to:
            - ipBlock:
                cidr: 0.0.0.0/0
                except:
                - 169.254.169.254/32
          redis-subnets:
            ports:
            - port: 6379
              protocol: TCP
            to:
            - ipBlock:
                cidr: 192.168.0.0/16
            - ipBlock:
                cidr: 172.16.0.0/12
            - ipBlock:
                cidr: 10.0.0.0/8
          sso:
            to:
            - ipBlock:
                cidr: 0.0.0.0/0
          storage-subnets:
            ports:
            - port: 443
              protocol: TCP
            to:
            - ipBlock:
                cidr: 0.0.0.0/0
        from:
          headlamp:
            to:
              definition:
                kubeAPI: true
                sso: false
              k8s:
                tempo/tempo:9411: false
      enabled: false
      hbonePortInjection:
        enabled: false
      ingress:
        definitions:
          kubeAPI:
            from:
            - ipBlock:
                cidr: 192.168.0.0/16
            - ipBlock:
                cidr: 172.16.0.0/12
            - ipBlock:
                cidr: 10.0.0.0/8
          load-balancer-subnets:
            from:
            - ipBlock:
                cidr: 192.168.0.0/16
            - ipBlock:
                cidr: 172.16.0.0/12
            - ipBlock:
                cidr: 10.0.0.0/8
        to:
          headlamp:4466:
            from:
              k8s:
                monitoring-monitoring-prometheus-blackbox-exporter@monitoring/prometheus-blackbox-exporter: false
  defaults:
    |-
      bbtests:
        cypress:
          envs:
            cypress_keycloak_test_enable: "false"
            cypress_keycloak_url: https://keycloak.lab.example.invalid/
            cypress_tnr_password: tnr_w!G33ZyAt@C8
            cypress_tnr_username: cypress
            cypress_url: https://headlamp.lab.example.invalid
      domain: lab.example.invalid
      istio:
        ambient:
          enabled: false
        authorizationPolicies:
          enabled: false
          generateFromNetpol: false
        enabled: false
        injection: enabled
        sidecar:
          enabled: false
      networkPolicies:
        egress:
          definitions:
            database-subnets:
              ports:
              - port: 5432
                protocol: TCP
              to:
              - ipBlock:
                  cidr: 192.168.0.0/16
              - ipBlock:
                  cidr: 172.16.0.0/12
              - ipBlock:
                  cidr: 10.0.0.0/8
            kafka-subnets:
              ports:
              - port: 9092
                protocol: TCP
              - port: 9093
                protocol: TCP
              to:
              - ipBlock:
                  cidr: 0.0.0.0/0
            kubeAPI:
              to:
              - ipBlock:
                  cidr: 0.0.0.0/0
                  except:
                  - 169.254.169.254/32
            redis-subnets:
              ports:
              - port: 6379
                protocol: TCP
              to:
              - ipBlock:
                  cidr: 192.168.0.0/16
              - ipBlock:
                  cidr: 172.16.0.0/12
              - ipBlock:
                  cidr: 10.0.0.0/8
            sso:
              to:
              - ipBlock:
                  cidr: 0.0.0.0/0
            storage-subnets:
              ports:
              - port: 443
                protocol: TCP
              to:
              - ipBlock:
                  cidr: 0.0.0.0/0
          from:
            headlamp:
              to:
                definition:
                  kubeAPI: true
                  sso: false
                k8s:
                  tempo/tempo:9411: false
        enabled: false
        hbonePortInjection:
          enabled: false
        ingress:
          definitions:
            kubeAPI:
              from:
              - ipBlock:
                  cidr: 192.168.0.0/16
              - ipBlock:
                  cidr: 172.16.0.0/12
              - ipBlock:
                  cidr: 10.0.0.0/8
            load-balancer-subnets:
              from:
              - ipBlock:
                  cidr: 192.168.0.0/16
              - ipBlock:
                  cidr: 172.16.0.0/12
              - ipBlock:
                  cidr: 10.0.0.0/8
          to:
            headlamp:4466:
              from:
                k8s:
                  monitoring-monitoring-prometheus-blackbox-exporter@monitoring/prometheus-blackbox-exporter: false
      openshift: false
      routes:
        inbound:
          headlamp:
            enabled: true
            gateways:
            - istio-gateway/public-ingressgateway
            hosts:
            - headlamp.lab.example.invalid
            port: 4466
            service: headlamp-headlamp
        outbound:
          headlamp-bb-tests:
            enabled: false
            hosts:
            - repo1.dso.mil
          sso:
            enabled: false
      upstream:
        config:
          oidc:
            secret:
              create: false
        image:
          pullPolicy: IfNotPresent
        imagePullSecrets: []
  overlays: |
    bigbang:
      rbac:
        enabled: false
    upstream:
      clusterRoleBinding:
        create: false
      config:
        unsafeUseServiceAccountToken: false
      replicaCount: 1
    waitJob:
      enabled: false
