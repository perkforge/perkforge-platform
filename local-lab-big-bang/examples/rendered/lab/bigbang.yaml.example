# Source: bigbang/templates/headlamp/helmrelease.yaml
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: headlamp
  namespace: bigbang
  labels:
    app.kubernetes.io/name: headlamp
    app.kubernetes.io/component: "core"
    app.kubernetes.io/instance: bigbang
    app.kubernetes.io/version: 3.35.1
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/part-of: "bigbang"
    helm.sh/chart: bigbang-3.35.1
  annotations:
    checksum/bigbang-values: b4fbb59469c9d585d0cf67a4b063068ed3aeae9099e3e227eb72025c29457e76
spec:
  targetNamespace: headlamp

  chart:
    spec:
      chart: ./chart
      sourceRef:
        kind: GitRepository
        name: headlamp
        namespace: bigbang
      interval: 5m
  driftDetection:
    ignore:
    - paths:
      - ""
      target:
        kind: Job
    - paths:
      - ""
      target:
        kind: StatefulSet
    mode: enabled
  install:
    remediation:
      retries: -1
  interval: 2m
  rollback:
    cleanupOnFail: true
    timeout: 10m
  test:
    enable: false
  timeout: 10m
  upgrade:
    cleanupOnFail: true
    remediation:
      remediateLastFailure: true
      retries: 3
  valuesFrom:
    - name: bigbang-headlamp-values
      kind: Secret
      valuesKey: "common"
    - name: bigbang-headlamp-values
      kind: Secret
      valuesKey: "defaults"
    - name: bigbang-headlamp-values
      kind: Secret
      valuesKey: "overlays"
---
# Source: bigbang/templates/package/helmrelease.yaml
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: openbao
  namespace:
               bigbang

  labels:
    app.kubernetes.io/name: openbao
    app.kubernetes.io/instance: bigbang
    app.kubernetes.io/version: 3.35.1
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/part-of: "bigbang"
    helm.sh/chart: bigbang-3.35.1
  annotations:
    checksum/bigbang-values: 0d9263416a5da95bdac6c74b2b85b693a43847bc880d65da0403ed0af6163b6b
spec:
  releaseName: openbao
  targetNamespace: openbao
  chart:
    spec:
      chart: openbao
      version: 0.30.6
      sourceRef:
        kind: HelmRepository
        name: openbao-official
        namespace: bigbang
      interval: 2m
      reconcileStrategy: Revision
  driftDetection:
    ignore:
    - paths:
      - ""
      target:
        kind: Job
    - paths:
      - ""
      target:
        kind: StatefulSet
    mode: enabled
  install:
    remediation:
      retries: -1
  interval: 2m
  rollback:
    cleanupOnFail: true
    timeout: 10m
  test:
    enable: false
  timeout: 10m
  upgrade:
    cleanupOnFail: true
    remediation:
      remediateLastFailure: true
      retries: 3
  valuesFrom:
    - name: openbao-values
      kind: Secret
      valuesKey: values.yaml
---
