# Rendered by Ansible's standard template lookup; no credentials included.
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: cluster-config
  namespace: flux-system
spec:
  suspend: true
  interval: 1m
  url: {{ config_repository | to_json }}
  ref:
    tag: {{ config_tag | to_json }}
{% if config_source_secret | default('cluster-config-read') | length > 0 %}
  secretRef:
    name: {{ config_source_secret | default('cluster-config-read') | to_json }}
{% endif %}
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: cluster-root
  namespace: flux-system
  annotations:
    example.perkforge.io/cluster: {{ inventory_hostname | to_json }}
    example.perkforge.io/environment: {{ deployment_environment | to_json }}
    example.perkforge.io/profile: {{ impact_profile | to_json }}
spec:
  suspend: true
  interval: 5m
  timeout: 5m
  path: {{ gitops_path | to_json }}
  sourceRef:
    kind: GitRepository
    name: cluster-config
  serviceAccountName: platform-reconciler # Stage foundation provisions the scoped identity separately.
  prune: false # No deletion authority is introduced by this seed.
  wait: true
