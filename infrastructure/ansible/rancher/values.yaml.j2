# Platform management only; Flux owns application deployment.
hostname: {{ rancher_hostname | to_json }}
replicas: {{ rancher_replicas | int }}
features: "continuous-delivery=false"
agentTLSMode: strict
privateCA: {{ rancher_private_ca | bool | to_json }}
additionalTrustedCAs: {{ rancher_additional_trusted_cas | bool | to_json }}
ingress:
  ingressClassName: {{ rancher_ingress_class | to_json }}
  tls:
    source: secret
    secretName: tls-rancher-ingress
